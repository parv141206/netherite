    {
      "id": "NMIBv7RBAtzgXeAFO1FUo",
      "type": "text",
      "x": 3397.4832581300325,
      "y": 1598.9662504586775,
      "width": 647.7993774414062,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aJ",
      "roundness": null,
      "seed": 1242608992,
      "version": 175,
      "versionNonce": 1313608864,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789447433630,
      "created": 1789447433616,
      "link": null,
      "locked": false,
      "text": "Three Key System Software Principles Highlighted by the Hierarchy\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Three Key System Software Principles Highlighted by the Hierarchy\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "_HGO5QRAMF-eV5jJTlca3",
      "type": "text",
      "x": 3227.6268440234126,
      "y": 1666.1132345782662,
      "width": 316.13481906296226,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aK",
      "roundness": null,
      "seed": 622004576,
      "version": 233,
      "versionNonce": 463799648,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789447433630,
      "created": 1789447433616,
      "link": null,
      "locked": false,
      "text": "Device Independence: High-level\napplications remain independent\nof physical device variations\nbecause lower layers\n(drivers/OS) abstract device-\nspecific electronics",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Device Independence: High-level applications remain independent of physical device variations because lower layers (drivers/OS) abstract device-specific electronics",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "ODCHWmuHNUxknxfyASFpk",
      "type": "text",
      "x": 3576.5688369448717,
      "y": 1671.9706876099185,
      "width": 316.13481906296226,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aL",
      "roundness": null,
      "seed": 346742112,
      "version": 330,
      "versionNonce": 555778208,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789447433630,
      "created": 1789447433616,
      "link": null,
      "locked": false,
      "text": "Interface Isolation: Clean\ninterfaces (APIs and ABIs)\nseparate layers\n. An API (Application\nProgramming Interface) provides\nsource-level functions, while an\nABI (Application Binary\nInterface) defines low-level\nbinary rules such as register\nusage, stack alignment, and\ncalling conventions",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Interface Isolation: Clean interfaces (APIs and ABIs) separate layers\n. An API (Application Programming Interface) provides source-level functions, while an ABI (Application Binary Interface) defines low-level binary rules such as register usage, stack alignment, and calling conventions",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "yOV95sqVTYQ8F0gKiAREV",
      "type": "text",
      "x": 3920.2228638343367,
      "y": 1667.3893022212415,
      "width": 316.13481906296226,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 1781018976,
      "version": 451,
      "versionNonce": 1604147552,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789447433630,
      "created": 1789447433616,
      "link": null,
      "locked": false,
      "text": "Separation of Mechanism and\nPolicy: Hardware provides\nphysical mechanisms (e.g.,\nhardware timer interrupts), while\nsystem software decides the\nmanagement policies (e.g., round-\nrobin CPU time-slicing policy)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Separation of Mechanism and Policy: Hardware provides physical mechanisms (e.g., hardware timer interrupts), while system software decides the management policies (e.g., round-robin CPU time-slicing policy)",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
