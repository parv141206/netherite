      "updated": 1789462811599,
      "created": 1789447433617,
      "link": null,
      "locked": false,
      "text": "Types of Semantic Gaps",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Types of Semantic Gaps",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "o-lK9sdi3fELtatb7d_Rs",
      "type": "text",
      "x": 4093.657795963076,
      "y": 2701.4713905695785,
      "width": 450.0448675091418,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b17",
      "roundness": null,
      "seed": 1243706720,
      "version": 469,
      "versionNonce": 1725100636,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "6MP6RQWSIynI1r3UTqXcU",
          "type": "arrow"
        }
      ],
      "updated": 1789462811599,
      "created": 1789447433617,
      "link": null,
      "locked": false,
      "text": "Specification Gap: The semantic gap between\nthe Application Domain and the Programming-\nLanguage Domain. It represents the effort\nrequired by a software developer to write an\nalgorithmic specification for a real-world task",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Specification Gap: The semantic gap between the Application Domain and the Programming-Language Domain. It represents the effort required by a software developer to write an algorithmic specification for a real-world task",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "I6ZwqqxRkNDUulzk9meu0",
      "type": "text",
      "x": 4572.612510405986,
      "y": 2714.028397038262,
      "width": 405.42331949139543,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b18",
      "roundness": null,
      "seed": 1695271264,
      "version": 503,
      "versionNonce": 486295260,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "XKe_9jOnFc9hCDiTgTIlc",
          "type": "arrow"
        }
      ],
      "updated": 1789462811599,
      "created": 1789447433617,
      "link": null,
      "locked": false,
      "text": "Execution Gap: The semantic gap\nbetween the Programming-Language\nDomain and the Execution Domain. It\nrepresents the complexity faced by a\nlanguage processor (compiler/assembler)\nwhen translating programming constructs\ninto raw machine code",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Execution Gap: The semantic gap between the Programming-Language Domain and the Execution Domain. It represents the complexity faced by a language processor (compiler/assembler) when translating programming constructs into raw machine code",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
