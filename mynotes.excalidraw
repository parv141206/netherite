    {
      "id": "YVJ_g6yb94O9Iqo_rqOx_",
      "type": "text",
      "x": 7713.976066757352,
      "y": 3007.830362564187,
      "width": 335.1673116034581,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
