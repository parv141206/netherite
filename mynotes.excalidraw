      "created": 1789464854485,
      "link": null,
      "locked": false,
      "text": "Memory Efficiency\n(Compactness): Must occupy\nminimal RAM space so\nmulti-pass compilers can\nretain large code blocks\nin memory without disk\nswapping.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Memory Efficiency (Compactness): Must occupy minimal RAM space so multi-pass compilers can retain large code blocks in memory without disk swapping.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
