      "updated": 1789447433630,
      "created": 1789447433617,
      "link": null,
      "locked": false,
      "text": "Address Space: Physical vs. Logical Address Space",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Address Space: Physical vs. Logical Address Space",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "wouDPN5lZ4b7wekl64rTn",
      "type": "text",
      "x": 4996.94531434729,
      "y": 1339.4043664061023,
      "width": 460.1801295966456,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0A",
      "roundness": null,
      "seed": 1323768160,
      "version": 269,
      "versionNonce": 1130958176,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "BBz-S_uMVd6nmgRouC-S5",
          "type": "arrow"
        },
        {
          "id": "iOXQwzasl6FSa5tqy_Mpd",
          "type": "arrow"
        }
      ],
      "updated": 1789447433630,
      "created": 1789447433617,
      "link": null,
      "locked": false,
      "text": "The Logical Address Space (or Virtual Address\nSpace) of a program is the complete set of\nmemory addresses generated by a compiler or\nlinker that the program can reference during\nits execution",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Logical Address Space (or Virtual Address Space) of a program is the complete set of memory addresses generated by a compiler or linker that the program can reference during its execution",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "P9_G3Rt3EczKgxn5ucPIe",
      "type": "text",
      "x": 5632.069054275251,
      "y": 1339.5615701516344,
      "width": 327.06784096097846,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0B",
      "roundness": null,
      "seed": 159182176,
      "version": 184,
      "versionNonce": 1300297888,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "mf75aWohmVuPNyCk5RWQ9",
          "type": "arrow"
        }
      ],
      "updated": 1789447433630,
      "created": 1789447433617,
      "link": null,
      "locked": false,
      "text": "The Physical Address Space is\nthe set of actual hardware RAM\nlocations installed on the\ncomputer",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Physical Address Space is the set of actual hardware RAM locations installed on the computer",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
