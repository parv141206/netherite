    {
      "id": "w6yaaq_WfJE8xCxS-wpuF",
      "type": "text",
      "x": 6920.119910992106,
      "y": 4046.401652215044,
      "width": 578.4356689453126,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff4e6",
      "fillStyle": "solid",
