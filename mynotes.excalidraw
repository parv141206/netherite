    {
      "id": "Em84FUPx6SJEqcsMUEgsY",
      "type": "text",
      "x": 2462.866661901246,
      "y": 1092.8258228097932,
      "width": 730.6444193218033,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
