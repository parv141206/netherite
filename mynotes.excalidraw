      "seed": 1864549988,
      "version": 365,
      "versionNonce": 1682849892,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789465530829,
      "created": 1789464547051,
      "link": null,
      "locked": false,
      "text": "Line 10:   percent_profit = (profit * 100) / cost_price;  ; Uses 'profit' before declaration!\n           ...\nLine 40:   double profit;                                ; Declared down here!",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Line 10:   percent_profit = (profit * 100) / cost_price;  ; Uses 'profit' before declaration!\n           ...\nLine 40:   double profit;                                ; Declared down here!",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Na704vojLtogOAHieuARn",
      "type": "text",
      "x": 7846.366480539124,
      "y": 1800.0990528992575,
      "width": 704,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2i",
      "roundness": null,
      "seed": 459024092,
      "version": 309,
      "versionNonce": 1847234140,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789465537918,
      "created": 1789464575528,
      "link": null,
      "locked": false,
      "text": "The Problem: When the processor reads Line 10, it doesn't know\nwhether profit is a 4-byte float or an 8-byte double. Therefore, it\ncannot generate the correct type-conversion or arithmetic instructions\non a single statement-by-statement pass!",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Problem: When the processor reads Line 10, it doesn't know whether profit is a 4-byte float or an 8-byte double. Therefore, it cannot generate the correct type-conversion or arithmetic instructions on a single statement-by-statement pass!",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
