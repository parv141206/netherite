    {
      "id": "tASJgb-OctCZc6aiycJ9p",
      "type": "text",
      "x": 3910.068174382962,
      "y": 5031.962271132701,
      "width": 1297.99853515625,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#d0bfff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b57",
      "roundness": null,
      "seed": 43007036,
      "version": 133,
      "versionNonce": 526632380,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789616712657,
      "created": 1789616402889,
      "link": null,
      "locked": false,
      "text": "  DIRECTIVE     SYNTAX                  FUNCTION / ACTION\n  ─────────     ──────                  ─────────────────\n  START         START <address>         Sets the Location Counter (LC) to initial load address [12].\n  END           END [<start_label>]     Marks the end of source text; triggers final literal pool processing [12, 13].\n  ORIGIN        ORIGIN <address_spec>   Sets LC to the specified absolute or relative address [14].\n  EQU           <symbol> EQU <addr>     Binds <symbol> to the value of <addr> without reserving memory [14].\n  LTORG         LTORG                   Allocates memory for all unallocated literals in current pool [15, 16].\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "  DIRECTIVE     SYNTAX                  FUNCTION / ACTION\n  ─────────     ──────                  ─────────────────\n  START         START <address>         Sets the Location Counter (LC) to initial load address [12].\n  END           END [<start_label>]     Marks the end of source text; triggers final literal pool processing [12, 13].\n  ORIGIN        ORIGIN <address_spec>   Sets LC to the specified absolute or relative address [14].\n  EQU           <symbol> EQU <addr>     Binds <symbol> to the value of <addr> without reserving memory [14].\n  LTORG         LTORG                   Allocates memory for all unallocated literals in current pool [15, 16].\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
