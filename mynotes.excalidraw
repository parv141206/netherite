      "link": null,
      "locked": false,
      "text": "Responsibility: Concerned exclusively with the architecture\nand constraints of the Target Machine.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Responsibility: Concerned exclusively with the architecture and constraints of the Target Machine.",
