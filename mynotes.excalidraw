      ],
      "updated": 1789447433630,
      "created": 1789447433616,
      "link": null,
      "locked": false,
      "text": "Manage System Resources: Control, schedule,\nallocate, and protect CPU execution time, main\nmemory, storage space, and I/O devices among\nmultiple competing application programs without\ninterference",
