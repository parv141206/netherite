      "version": 340,
      "versionNonce": 1550759516,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789465418211,
      "created": 1789464479732,
      "link": null,
      "locked": false,
      "text": "A language processor pass is one complete traversal of the\nsource program (or its equivalent intermediate representation)\nwhile performing a defined set of language-processing functions.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A language processor pass is one complete traversal of the source program (or its equivalent intermediate representation) while performing a defined set of language-processing functions.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "mbtDOfBy_brELzs52aEnu",
      "type": "text",
