        }
      ],
      "updated": 1789617134191,
      "created": 1789616969968,
      "link": null,
      "locked": false,
      "text": "Pass 1 (Analysis Phase): Performs Location Counter (LC) processing, builds\nSYMTAB, LITTAB, and POOLTAB, and outputs Intermediate Code",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pass 1 (Analysis Phase): Performs Location Counter (LC) processing, builds SYMTAB, LITTAB, and POOLTAB, and outputs Intermediate Code",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
