    {
      "id": "XljKJ7DlbZsqXfm20ZoC5",
      "type": "text",
      "x": 3223.4757126758527,
      "y": 3139.912915941149,
      "width": 300.3597717285156,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
