      "boundElements": [],
      "updated": 1789447433630,
      "created": 1789447433616,
      "link": null,
      "locked": false,
      "text": "Systems programming is the body of\nconcepts, design principles, and software\ntechniques used to design and implement\nsystem programs",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Systems programming is the body of concepts, design principles, and software techniques used to design and implement system programs",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "M7MFDK_1M22k917mCS6wz",
      "type": "text",
      "x": 3439.249223511162,
      "y": 642.8630766677718,
      "width": 472.43951416015625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
