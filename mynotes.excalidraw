    },
    {
      "id": "igTAMu8PjngO9HpJ2L3Gg",
      "type": "text",
      "x": 1733.9591575779232,
      "y": 4926.677229412382,
      "width": 670.9991455078125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#d0bfff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4v",
      "roundness": null,
      "seed": 1243728956,
      "version": 314,
      "versionNonce": 1829912764,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789616712657,
      "created": 1789616073328,
      "link": null,
      "locked": false,
      "text": "Machine Code Mapping: Each imperative statement translates 1-to-1\ninto one machine instruction",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Machine Code Mapping: Each imperative statement translates 1-to-1 into one machine instruction",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "0cHub4VDxBqOxTJbhJddB",
      "type": "text",
      "x": 1612.6233186219627,
      "y": 5024.478004381371,
      "width": 912.9996337890625,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#d0bfff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4w",
      "roundness": null,
      "seed": 26084924,
      "version": 247,
      "versionNonce": 251840828,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789616712657,
      "created": 1789616116493,
      "link": null,
      "locked": false,
      "text": "+---------------------------------------------------------------------------------+\n|                    DHAMDHERE INSTRUCTION MODEL (OPCODE TABLE)                   |\n+---------------+-------------------+---------------+-----------------------------+\n| Mnemonic      | Opcode            | Mnemonic      | Opcode                      |\n+---------------+-------------------+---------------+-----------------------------+\n| STOP          | 00                | COMP          | 06                          |\n| ADD           | 01                | BC            | 07                          |\n| SUB           | 02                | DIV           | 08                          |\n| MULT          | 03                | READ          | 09                          |\n| MOVER         | 04                | PRINT         | 10                          |\n| MOVEM         | 05                |               |                             |\n+---------------+-------------------+---------------+-----------------------------+\n\n+---------------------------------------------------------------------------------+\n|                       BRANCH CONDITIONS FOR BC (07)                             |\n+---------------+-------------------+---------------+-----------------------------+\n| Code          | Condition         | Code          | Condition                   |\n+---------------+-------------------+---------------+-----------------------------+\n| 1             | LT (Less Than)    | 4             | GT (Greater Than)           |\n| 2             | LE (Less/Equal)   | 5             | GE (Greater/Equal)          |\n| 3             | EQ (Equal)        | 6             | ANY (Unconditional)         |\n+---------------+-------------------+---------------+-----------------------------+",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "+---------------------------------------------------------------------------------+\n|                    DHAMDHERE INSTRUCTION MODEL (OPCODE TABLE)                   |\n+---------------+-------------------+---------------+-----------------------------+\n| Mnemonic      | Opcode            | Mnemonic      | Opcode                      |\n+---------------+-------------------+---------------+-----------------------------+\n| STOP          | 00                | COMP          | 06                          |\n| ADD           | 01                | BC            | 07                          |\n| SUB           | 02                | DIV           | 08                          |\n| MULT          | 03                | READ          | 09                          |\n| MOVER         | 04                | PRINT         | 10                          |\n| MOVEM         | 05                |               |                             |\n+---------------+-------------------+---------------+-----------------------------+\n\n+---------------------------------------------------------------------------------+\n|                       BRANCH CONDITIONS FOR BC (07)                             |\n+---------------+-------------------+---------------+-----------------------------+\n| Code          | Condition         | Code          | Condition                   |\n+---------------+-------------------+---------------+-----------------------------+\n| 1             | LT (Less Than)    | 4             | GT (Greater Than)           |\n| 2             | LE (Less/Equal)   | 5             | GE (Greater/Equal)          |\n| 3             | EQ (Equal)        | 6             | ANY (Unconditional)         |\n+---------------+-------------------+---------------+-----------------------------+",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "XOx-vkKeG-VTHxd3SD78h",
