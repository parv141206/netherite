      "text": "Ease of Use: Must\nbe simple for the\nfront end to\ngenerate and easy\nfor the back end to\nanalyze.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ease of Use: Must be simple for the front end to generate and easy for the back end to analyze.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
