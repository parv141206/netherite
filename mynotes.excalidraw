      "isDeleted": false,
      "boundElements": [
        {
          "id": "7yePcaB6ae0AlbWI19iCi",
          "type": "arrow"
        }
      ],
      "updated": 1789620206082,
      "created": 1789618832295,
      "link": null,
      "locked": false,
      "text": "A Single-Pass Assembler translates the source program\ninto target machine code in a single scan, eliminating\nintermediate code files\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A Single-Pass Assembler translates the source program into target machine code in a single scan, eliminating intermediate code files\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "qnmQo6Zw69oZRsoIo5Dd6",
      "type": "text",
      "x": 7066.03918182544,
      "y": 4199.380818881711,
      "width": 282.4597473144531,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff4e6",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7V",
      "roundness": null,
      "seed": 1723584900,
      "version": 54,
      "versionNonce": 1187191044,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789620210299,
      "created": 1789618857085,
      "link": null,
      "locked": false,
      "text": "The Backpatching Mechanism",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Backpatching Mechanism",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "AWoZz12UnO9FfLkHf6vb4",
      "type": "text",
      "x": 6945.886229419299,
      "y": 4240.339214219012,
      "width": 492.4994812011719,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff4e6",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7W",
      "roundness": null,
      "seed": 737371708,
      "version": 89,
      "versionNonce": 1015109764,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789620210299,
      "created": 1789620135502,
      "link": null,
      "locked": false,
      "text": "When a forward reference occurs, the instruction's\naddress field cannot be filled immediately",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When a forward reference occurs, the instruction's address field cannot be filled immediately",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "s-fPrd6r1qKabE1iAuC02",
      "type": "text",
      "x": 6965.43211259801,
      "y": 4303.663866996791,
      "width": 474.57958984375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff4e6",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7X",
      "roundness": null,
      "seed": 904054532,
      "version": 142,
      "versionNonce": 1867229188,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789620210300,
      "created": 1789620154704,
      "link": null,
      "locked": false,
      "text": "The assembler leaves the address field blank (or\nzero) in memory, logs an entry in the Table of\nIncomplete Instructions (TII)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The assembler leaves the address field blank (or zero) in memory, logs an entry in the Table of Incomplete Instructions (TII)",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
