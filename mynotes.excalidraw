    {
      "id": "ob_2S1iWk_-BRUS2iSZ5A",
      "type": "text",
      "x": 2673.6264040743094,
      "y": 4289.726437502753,
      "width": 835.9993896484375,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#d0bfff",
