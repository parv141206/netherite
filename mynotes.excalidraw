      "isDeleted": false,
      "boundElements": [],
      "updated": 1789465418211,
      "created": 1789463684229,
      "link": null,
      "locked": false,
      "text": "Key Tasks: Memory/Storage Allocation, Instruction\nSelection, Register Allocation, and Target Code Emission.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Key Tasks: Memory/Storage Allocation, Instruction Selection, Register Allocation, and Target Code Emission.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "adZC8a4i_dSiRodsRITaA",
      "type": "text",
      "x": 8702.949350881207,
      "y": 547.3094613163396,
      "width": 594.6796264648438,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b22",
      "roundness": null,
      "seed": 1007795932,
      "version": 353,
      "versionNonce": 463978972,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789465418211,
      "created": 1789463691808,
      "link": null,
      "locked": false,
      "text": "Portability Benefit: If you want to target a new hardware\narchitecture (e.g., ARM64 instead of x86_64), you only need\nto write a new Back End that consumes the same IR!",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Portability Benefit: If you want to target a new hardware architecture (e.g., ARM64 instead of x86_64), you only need to write a new Back End that consumes the same IR!",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
