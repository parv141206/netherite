      "isDeleted": false,
      "boundElements": [
        {
          "id": "CNOrYgW_ZfFi2cyKztdy0",
          "type": "arrow"
        }
      ],
      "updated": 1789447433630,
      "link": null,
      "locked": false,
      "text": "System software is a collection of programs that provides a convenient\nenvironment for developing and executing user programs while controlling\nand efficiently utilizing the physical resources of the computer system\n. An individual program belonging to this collection is called a system\nprogram",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "System software is a collection of programs that provides a convenient environment for developing and executing user programs while controlling and efficiently utilizing the physical resources of the computer system\n. An individual program belonging to this collection is called a system program",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1789447433616,
      "labelPosition": null,
      "baseFontSize": null
    },
