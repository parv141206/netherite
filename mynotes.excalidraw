      "text": "Introduction, Software, and Software Hierarchy",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Introduction, Software, and Software Hierarchy",
