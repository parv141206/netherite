      "type": "text",
      "x": 4126.5216037004375,
      "y": 5807.265677512664,
      "width": 1132.9993896484375,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff4e6",
      "fillStyle": "solid",
