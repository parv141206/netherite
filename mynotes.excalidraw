      "seed": 1302247132,
      "version": 191,
      "versionNonce": 728650980,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789465769648,
      "created": 1789465761712,
      "link": null,
      "locked": false,
      "text": "Search Data Structures: Stores\nattributes of program entities\n(variables, functions, labels) where\nfast lookup speed is the primary\ndesign objective. Examples: Symbol\nTable (SYMTAB), Opcode Table\n(OPTAB), Constant Table.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Search Data Structures: Stores attributes of program entities (variables, functions, labels) where fast lookup speed is the primary design objective. Examples: Symbol Table (SYMTAB), Opcode Table (OPTAB), Constant Table.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "oLCE5iYiuBygDSa6YY_j8",
      "type": "text",
      "x": 8213.606404345392,
      "y": 2974.5002819220667,
      "width": 246.00454022316717,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3V",
      "roundness": null,
      "seed": 1803451100,
      "version": 130,
      "versionNonce": 2110311004,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789465807134,
      "created": 1789465798489,
      "link": null,
      "locked": false,
      "text": "Allocation Data\nStructures: Manages\ndynamic memory\nassignment and scope\nrules during program\nexecution or translation.\nExamples: Call Stack,\nHeap, Display Vector.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Allocation Data Structures: Manages dynamic memory assignment and scope rules during program execution or translation. Examples: Call Stack, Heap, Display Vector.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
