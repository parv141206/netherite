    {
      "id": "WzjXjEf5JSGAyd3SQr08L",
      "type": "text",
      "x": 10799.110532891911,
      "y": 4604.6143723291225,
      "width": 956.9988403320312,
      "height": 1375,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "#fff4e6",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b83",
      "roundness": null,
      "seed": 460071356,
      "version": 67,
      "versionNonce": 901650108,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "k5xmnBYmFonA60SQ77mbO",
          "type": "arrow"
        }
      ],
      "updated": 1789621681112,
      "created": 1789621451263,
      "link": null,
      "locked": false,
      "text": "1. INITIALIZATION:\n   code_area_address := Base address of target code output buffer;\n   pooltab_ptr := 1;\n   LC := 0;\n\n2. PROCESSING LOOP:\n   WHILE next IC unit is NOT '(AD, 02)' (END) DO:\n   \n     a. Clear machine_code_buffer;\n     \n     b. IF IC unit is LTORG THEN\n            -- Assemble literal values into machine code\n            FOR i := POOLTAB[pooltab_ptr] TO (POOLTAB[pooltab_ptr + 1] - 1) DO:\n                Assemble literal value into machine_code_buffer;\n                Emit machine_code_buffer to (code_area_address + LC);\n                LC := LC + 1;\n            END FOR;\n            pooltab_ptr := pooltab_ptr + 1;\n            size := 0;\n            \n     c. ELSE IF IC unit is START or ORIGIN THEN\n            LC := Value specified in operand field;\n            size := 0;\n            \n     d. ELSE IF IC unit is DC THEN\n            Assemble constant value into machine_code_buffer;\n            size := 1;\n            \n     e. ELSE IF IC unit is DS THEN\n            size := Size specified in DS statement;\n            -- No machine code emitted, just advance LC!\n            \n     f. ELSE IF IC unit is Imperative Statement (IS) THEN\n            opcode := Machine opcode from IC tuple;\n            reg := Register code from IC tuple;\n            \n            -- Resolve Memory Operand\n            IF operand is (S, entry_no) THEN\n                mem_addr := SYMTAB[entry_no].address;\n            ELSE IF operand is (L, entry_no) THEN\n                mem_addr := LITTAB[entry_no].address;\n            END IF;\n            \n            Assemble instruction: [ Opcode | Reg | mem_addr ] into machine_code_buffer;\n            size := Instruction length;\n     END IF;\n\n     g. IF size != 0 THEN\n            Write machine_code_buffer to (code_area_address + LC);\n            LC := LC + size;\n     END IF;\n   END WHILE;\n\n3. TERMINATION:\n   Write target code file to disk and output program listing.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. INITIALIZATION:\n   code_area_address := Base address of target code output buffer;\n   pooltab_ptr := 1;\n   LC := 0;\n\n2. PROCESSING LOOP:\n   WHILE next IC unit is NOT '(AD, 02)' (END) DO:\n   \n     a. Clear machine_code_buffer;\n     \n     b. IF IC unit is LTORG THEN\n            -- Assemble literal values into machine code\n            FOR i := POOLTAB[pooltab_ptr] TO (POOLTAB[pooltab_ptr + 1] - 1) DO:\n                Assemble literal value into machine_code_buffer;\n                Emit machine_code_buffer to (code_area_address + LC);\n                LC := LC + 1;\n            END FOR;\n            pooltab_ptr := pooltab_ptr + 1;\n            size := 0;\n            \n     c. ELSE IF IC unit is START or ORIGIN THEN\n            LC := Value specified in operand field;\n            size := 0;\n            \n     d. ELSE IF IC unit is DC THEN\n            Assemble constant value into machine_code_buffer;\n            size := 1;\n            \n     e. ELSE IF IC unit is DS THEN\n            size := Size specified in DS statement;\n            -- No machine code emitted, just advance LC!\n            \n     f. ELSE IF IC unit is Imperative Statement (IS) THEN\n            opcode := Machine opcode from IC tuple;\n            reg := Register code from IC tuple;\n            \n            -- Resolve Memory Operand\n            IF operand is (S, entry_no) THEN\n                mem_addr := SYMTAB[entry_no].address;\n            ELSE IF operand is (L, entry_no) THEN\n                mem_addr := LITTAB[entry_no].address;\n            END IF;\n            \n            Assemble instruction: [ Opcode | Reg | mem_addr ] into machine_code_buffer;\n            size := Instruction length;\n     END IF;\n\n     g. IF size != 0 THEN\n            Write machine_code_buffer to (code_area_address + LC);\n            LC := LC + size;\n     END IF;\n   END WHILE;\n\n3. TERMINATION:\n   Write target code file to disk and output program listing.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
