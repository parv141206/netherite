    },
    {
      "id": "0zUaLnQIvdu8rCP92REhH",
      "type": "text",
      "x": 8390.989346135962,
      "y": 5164.583029323172,
      "width": 934.9987182617188,
      "height": 1550,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "#fff4e6",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b89",
      "roundness": null,
      "seed": 1719827516,
      "version": 112,
      "versionNonce": 501269252,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789621681112,
      "created": 1789621547341,
      "link": null,
      "locked": false,
      "text": "1. INITIALIZATION:\n   LC := 0;\n   Clear SYMTAB and TII;\n\n2. WHILE next statement is NOT 'END' DO:\n   \n     a. Process Label (Symbol Definition):\n        IF statement has a Label THEN\n            this_symbol := Symbol in label field;\n            \n            IF this_symbol exists in SYMTAB AND Defined == 'NO' THEN\n                -- Symbol was previously forward-referenced!\n                SYMTAB[this_symbol].address := LC;\n                SYMTAB[this_symbol].Defined := 'YES';\n                \n                -- BACKPATCHING STEP: Resolve all pending TII entries!\n                FOR EACH entry (instr_addr, symbol) in TII matching this_symbol DO:\n                    Patch memory at 'instr_addr': Set address field = LC;\n                    Remove entry from TII;\n                END FOR;\n            ELSE IF this_symbol NOT in SYMTAB THEN\n                Enter (this_symbol, LC, Defined = 'YES') into SYMTAB;\n            END IF;\n        END IF;\n\n     b. Process Imperative Statement:\n        IF statement is an Imperative Instruction THEN\n            opcode := Machine opcode;\n            symb := Operand symbol;\n            \n            IF symb is already in SYMTAB AND SYMTAB[symb].Defined == 'YES' THEN\n                -- Target address is known! Emit complete instruction directly to RAM\n                target_addr := SYMTAB[symb].address;\n                Emit [ Opcode | Reg | target_addr ] to RAM at address LC;\n            ELSE\n                -- FORWARD REFERENCE!\n                IF symb NOT in SYMTAB THEN\n                    Enter (symb, NULL, Defined = 'NO') into SYMTAB;\n                END IF;\n                \n                -- Emit incomplete instruction with blank address (000)\n                Emit [ Opcode | Reg | 000 ] to RAM at address LC;\n                \n                -- Log incomplete instruction in TII\n                Add (LC, symb) into TII;\n            END IF;\n            \n            LC := LC + instruction_length;\n        END IF;\n\n     c. Process DS / DC Declarations:\n        -- Update LC and emit constant bytes to RAM.\n   END WHILE;\n\n3. END STATEMENT PROCESSING:\n   -- Process remaining literals.\n   IF TII is NOT empty THEN\n       Report \"Error: Undefined Symbols Exist\" for all entries left in TII;\n   ELSE\n       Execution ready (Load-and-Go)!\n   END IF;\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. INITIALIZATION:\n   LC := 0;\n   Clear SYMTAB and TII;\n\n2. WHILE next statement is NOT 'END' DO:\n   \n     a. Process Label (Symbol Definition):\n        IF statement has a Label THEN\n            this_symbol := Symbol in label field;\n            \n            IF this_symbol exists in SYMTAB AND Defined == 'NO' THEN\n                -- Symbol was previously forward-referenced!\n                SYMTAB[this_symbol].address := LC;\n                SYMTAB[this_symbol].Defined := 'YES';\n                \n                -- BACKPATCHING STEP: Resolve all pending TII entries!\n                FOR EACH entry (instr_addr, symbol) in TII matching this_symbol DO:\n                    Patch memory at 'instr_addr': Set address field = LC;\n                    Remove entry from TII;\n                END FOR;\n            ELSE IF this_symbol NOT in SYMTAB THEN\n                Enter (this_symbol, LC, Defined = 'YES') into SYMTAB;\n            END IF;\n        END IF;\n\n     b. Process Imperative Statement:\n        IF statement is an Imperative Instruction THEN\n            opcode := Machine opcode;\n            symb := Operand symbol;\n            \n            IF symb is already in SYMTAB AND SYMTAB[symb].Defined == 'YES' THEN\n                -- Target address is known! Emit complete instruction directly to RAM\n                target_addr := SYMTAB[symb].address;\n                Emit [ Opcode | Reg | target_addr ] to RAM at address LC;\n            ELSE\n                -- FORWARD REFERENCE!\n                IF symb NOT in SYMTAB THEN\n                    Enter (symb, NULL, Defined = 'NO') into SYMTAB;\n                END IF;\n                \n                -- Emit incomplete instruction with blank address (000)\n                Emit [ Opcode | Reg | 000 ] to RAM at address LC;\n                \n                -- Log incomplete instruction in TII\n                Add (LC, symb) into TII;\n            END IF;\n            \n            LC := LC + instruction_length;\n        END IF;\n\n     c. Process DS / DC Declarations:\n        -- Update LC and emit constant bytes to RAM.\n   END WHILE;\n\n3. END STATEMENT PROCESSING:\n   -- Process remaining literals.\n   IF TII is NOT empty THEN\n       Report \"Error: Undefined Symbols Exist\" for all entries left in TII;\n   ELSE\n       Execution ready (Load-and-Go)!\n   END IF;\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
