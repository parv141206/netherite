      "locked": false,
      "text": "Life Cycle of a Source Program",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Life Cycle of a Source Program",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1789447433617,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "AMfBRaEslI1c7Ha35ajEH",
      "type": "text",
      "x": 2962.3826142708213,
      "y": 3215.466321300898,
      "width": 791.99609375,
      "height": 625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1H",
      "roundness": null,
      "seed": 1535477920,
      "version": 350,
      "versionNonce": 33615708,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789462811599,
      "created": 1789447447921,
      "link": null,
      "locked": false,
      "text": "  ┌──────────────────────────────────────────────────────────────┐\n  │ 1. Design & Source Editing   (Programmer uses Text Editor)   │\n  └──────────────────────────────┬───────────────────────────────┘\n                                 │ Source Text File (.c / .asm)\n                                 ▼\n  ┌──────────────────────────────────────────────────────────────┐\n  │ 2. Preprocessing & Translation (Preprocessor + Compiler/Assm)│\n  └──────────────────────────────┬───────────────────────────────┘\n                                 │ Relocatable Object Module (.o / .obj)\n                                 ▼\n  ┌──────────────────────────────────────────────────────────────┐\n  │ 3. Link Processing           (Linker resolves Ext References)│\n  └──────────────────────────────┬───────────────────────────────┘\n                                 │ Executable Binary File (.exe / a.out)\n                                 ▼\n  ┌──────────────────────────────────────────────────────────────┐\n  │ 4. Loading & Relocation      (Loader places code into RAM)   │\n  └──────────────────────────────┬───────────────────────────────┘\n                                 │ Allocated Memory Image\n                                 ▼\n  ┌──────────────────────────────────────────────────────────────┐\n  │ 5. Process Execution         (OS CPU Scheduling & Execution) │\n  └──────────────────────────────┬───────────────────────────────┘\n                                 │ Bugs / New Features\n                                 └──────────────► Loop back to Editing",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "  ┌──────────────────────────────────────────────────────────────┐\n  │ 1. Design & Source Editing   (Programmer uses Text Editor)   │\n  └──────────────────────────────┬───────────────────────────────┘\n                                 │ Source Text File (.c / .asm)\n                                 ▼\n  ┌──────────────────────────────────────────────────────────────┐\n  │ 2. Preprocessing & Translation (Preprocessor + Compiler/Assm)│\n  └──────────────────────────────┬───────────────────────────────┘\n                                 │ Relocatable Object Module (.o / .obj)\n                                 ▼\n  ┌──────────────────────────────────────────────────────────────┐\n  │ 3. Link Processing           (Linker resolves Ext References)│\n  └──────────────────────────────┬───────────────────────────────┘\n                                 │ Executable Binary File (.exe / a.out)\n                                 ▼\n  ┌──────────────────────────────────────────────────────────────┐\n  │ 4. Loading & Relocation      (Loader places code into RAM)   │\n  └──────────────────────────────┬───────────────────────────────┘\n                                 │ Allocated Memory Image\n                                 ▼\n  ┌──────────────────────────────────────────────────────────────┐\n  │ 5. Process Execution         (OS CPU Scheduling & Execution) │\n  └──────────────────────────────┬───────────────────────────────┘\n                                 │ Bugs / New Features\n                                 └──────────────► Loop back to Editing",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
