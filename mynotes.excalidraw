      "type": "text",
      "x": 7939.258694360524,
      "y": 1404.5166184239083,
      "width": 649,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
