      "isDeleted": false,
      "boundElements": null,
      "updated": 1789616712657,
      "created": 1789616026416,
      "link": null,
      "locked": false,
      "text": "LABEL FIELD (Optional)       OPCODE FIELD            OPERAND FIELD\n  +-----------------------+   +------------+   +---------------------------+\n  |         AGAIN         |   |    MULT    |   |      BREG, TERM+1(4)      |\n  +-----------------------+   +------------+   +---------------------------+\n   Associated as a symbolic    Instruction       Register / Memory Operand \n   name with memory location   Mnemonic          with optional Displacement",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LABEL FIELD (Optional)       OPCODE FIELD            OPERAND FIELD\n  +-----------------------+   +------------+   +---------------------------+\n  |         AGAIN         |   |    MULT    |   |      BREG, TERM+1(4)      |\n  +-----------------------+   +------------+   +---------------------------+\n   Associated as a symbolic    Instruction       Register / Memory Operand \n   name with memory location   Mnemonic          with optional Displacement",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
