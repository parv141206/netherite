      "type": "text",
      "x": 5694.315538043042,
      "y": 4261.500911422735,
      "width": 690.0393676757812,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff4e6",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5M",
      "roundness": null,
      "seed": 1887114372,
      "version": 33,
      "versionNonce": 1811903932,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789616889563,
      "created": 1789616888701,
      "link": null,
      "locked": false,
      "text": "A forward reference is a reference to a symbol that occurs before the\nstatement that defines or declares that symbol in the source text",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A forward reference is a reference to a symbol that occurs before the statement that defines or declares that symbol in the source text",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
