      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "1wcxa2a67kmgWl76-Voik",
      "type": "text",
      "x": 3269.917904761859,
      "y": 792.8903052488458,
      "width": 475.535122986626,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
