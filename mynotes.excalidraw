      "boundElements": null,
      "updated": 1789616712657,
      "created": 1789616222620,
      "link": null,
      "locked": false,
      "text": "DS (Declare Storage): Syntax: [Label] DS <constant>. \nReserves a contiguous block of memory words",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DS (Declare Storage): Syntax: [Label] DS <constant>. \nReserves a contiguous block of memory words",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "CbEEUXL2LNREkDmPRtV_M",
      "type": "text",
      "x": 2667.190004739231,
      "y": 5042.621174359824,
      "width": 337.77972412109375,
      "height": 25,
      "angle": 0,
