      "seed": 800196412,
      "version": 13,
      "versionNonce": 85266052,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789618097567,
      "created": 1789617193056,
      "link": null,
      "locked": false,
      "text": "                               +--------------------------------+\n                               |  TWO-PASS ASSEMBLER DATA STRS  |\n                               +---------------+----------------+\n                                               |\n        +----------------------+---------------+----------------------+----------------------+\n        |                      |                                      |                      |\n        v                      v                                      v                      v\n+---------------+      +---------------+                      +---------------+      +---------------+\n|     OPTAB     |      |    SYMTAB     |                      |    LITTAB     |      |    POOLTAB    |\n| (Opcode Table)|      |(Symbol Table) |                      |(Literal Table)|      | (Pool Table)  |\n+---------------+      +---------------+                      +---------------+      +---------------+\n| Fields:       |      | Fields:       |                      | Fields:       |      | Fields:       |\n| - Mnemonic    |      | - Symbol Name |                      | - Literal Name|      | - Literal Idx |\n| - Class       |      | - Address     |                      |   (e.g.,='5') |      |   (start index|\n|   (IS/DL/AD)  |      | - Length      |                      | - Address     |      |   for each    |\n| - Info        |      +---------------+                      +---------------+      |   pool)       |\n|   (Machine    |      | Type: Dynamic |                      | Type:         |      +---------------+\n|    Code/      |      | search struct |                      | Sequential    |      | Updated on    |\n|    RoutineID) |      | built in      |                      | list of       |      | LTORG or END  |\n+---------------+      | Pass 1, kept  |                      | literals used |      +---------------+\n| Type: Static  |      | for Pass 2    |                      | across pools  |\n| memory table  |      +---------------+                      +---------------+\n+---------------+",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "                               +--------------------------------+\n                               |  TWO-PASS ASSEMBLER DATA STRS  |\n                               +---------------+----------------+\n                                               |\n        +----------------------+---------------+----------------------+----------------------+\n        |                      |                                      |                      |\n        v                      v                                      v                      v\n+---------------+      +---------------+                      +---------------+      +---------------+\n|     OPTAB     |      |    SYMTAB     |                      |    LITTAB     |      |    POOLTAB    |\n| (Opcode Table)|      |(Symbol Table) |                      |(Literal Table)|      | (Pool Table)  |\n+---------------+      +---------------+                      +---------------+      +---------------+\n| Fields:       |      | Fields:       |                      | Fields:       |      | Fields:       |\n| - Mnemonic    |      | - Symbol Name |                      | - Literal Name|      | - Literal Idx |\n| - Class       |      | - Address     |                      |   (e.g.,='5') |      |   (start index|\n|   (IS/DL/AD)  |      | - Length      |                      | - Address     |      |   for each    |\n| - Info        |      +---------------+                      +---------------+      |   pool)       |\n|   (Machine    |      | Type: Dynamic |                      | Type:         |      +---------------+\n|    Code/      |      | search struct |                      | Sequential    |      | Updated on    |\n|    RoutineID) |      | built in      |                      | list of       |      | LTORG or END  |\n+---------------+      | Pass 1, kept  |                      | literals used |      +---------------+\n| Type: Static  |      | for Pass 2    |                      | across pools  |\n| memory table  |      +---------------+                      +---------------+\n+---------------+",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "9UDGEdKmirji9vMfhn24S",
      "type": "text",
      "x": 5414.938617860501,
      "y": 5951.891592702864,
      "width": 263.9996337890625,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
