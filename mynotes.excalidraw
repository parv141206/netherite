      "updated": 1789465418211,
      "created": 1789463868408,
      "link": null,
      "locked": false,
      "text": "┌──────────────────────────────────────────────┐\n│            Source Program (Input)            │\n└──────────────────────┬───────────────────────┘\n                       │\n                       ▼\n┌──────────────────────────────────────────────┐\n│                ANALYSIS PHASE                │\n│ • Lexical Analysis (Tokens)                  │\n│ • Syntax Analysis (Structure / Tree)         │\n│ • Semantic Analysis (Meaning & Types)        │\n└──────────────────────┬───────────────────────┘\n                       │\n                       ▼\n┌──────────────────────────────────────────────┐\n│     Intermediate Representation (IR) + Tables│\n└──────────────────────┬───────────────────────┘\n                       │\n                       ▼\n┌──────────────────────────────────────────────┐\n│               SYNTHESIS PHASE                │\n│ • Memory / Storage Allocation                │\n│ • Target Code Generation                     │\n└──────────────────────┬───────────────────────┘\n                       │\n                       ▼\n┌──────────────────────────────────────────────┐\n│            Target Program (Output)           │\n└──────────────────────────────────────────────┘",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "┌──────────────────────────────────────────────┐\n│            Source Program (Input)            │\n└──────────────────────┬───────────────────────┘\n                       │\n                       ▼\n┌──────────────────────────────────────────────┐\n│                ANALYSIS PHASE                │\n│ • Lexical Analysis (Tokens)                  │\n│ • Syntax Analysis (Structure / Tree)         │\n│ • Semantic Analysis (Meaning & Types)        │\n└──────────────────────┬───────────────────────┘\n                       │\n                       ▼\n┌──────────────────────────────────────────────┐\n│     Intermediate Representation (IR) + Tables│\n└──────────────────────┬───────────────────────┘\n                       │\n                       ▼\n┌──────────────────────────────────────────────┐\n│               SYNTHESIS PHASE                │\n│ • Memory / Storage Allocation                │\n│ • Target Code Generation                     │\n└──────────────────────┬───────────────────────┘\n                       │\n                       ▼\n┌──────────────────────────────────────────────┐\n│            Target Program (Output)           │\n└──────────────────────────────────────────────┘",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "wHtHfof43x1Egau1Mcxhf",
      "type": "rectangle",
