    {
      "id": "QOr-3S1Qg7F3D5i5CA993",
      "type": "text",
      "x": 4748.209206511575,
      "y": 563.976114550487,
      "width": 716.9793090820312,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ax",
      "roundness": null,
      "seed": 896521568,
      "version": 199,
      "versionNonce": 1432323232,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789447433630,
      "link": null,
      "locked": false,
      "text": " Systems Programming, Machine Structure, Address Space, and Interfaces",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " Systems Programming, Machine Structure, Address Space, and Interfaces",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1789447433617,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "_Vpt-5lETPYoiOrRW4KS-",
      "type": "text",
      "x": 4452.825573201356,
      "y": 705.201109166889,
      "width": 443.90069410489485,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ay",
      "roundness": null,
      "seed": 395192672,
      "version": 345,
      "versionNonce": 1438684512,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "oC87FfiBiTXVtfswv0rcW",
          "type": "arrow"
        }
      ],
      "updated": 1789447433630,
      "created": 1789447433617,
      "link": null,
      "locked": false,
      "text": "Systems programming is the body of\nconcepts, design principles, and software\ntechniques used to design and implement\nsystem software (such as compilers,\nassemblers, linkers, loaders, operating system\nkernels, and device drivers)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Systems programming is the body of concepts, design principles, and software techniques used to design and implement system software (such as compilers, assemblers, linkers, loaders, operating system kernels, and device drivers)",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "WpvEs89nb_p39WTLL2pHX",
      "type": "text",
      "x": 4484.561546109827,
      "y": 866.9202880716377,
      "width": 648.5781613191471,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "az",
      "roundness": null,
      "seed": 1254227296,
      "version": 346,
      "versionNonce": 1413869728,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789447433630,
      "created": 1789447433617,
      "link": null,
      "locked": false,
      "text": "Unlike application programming—which focuses on business logic\nand user-domain problems—systems programming deals directly\nwith the execution domain of the computer system",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Unlike application programming—which focuses on business logic and user-domain problems—systems programming deals directly with the execution domain of the computer system",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Wlih1fov5-Wi_5wWOPWeG",
      "type": "text",
      "x": 4439.526547482321,
      "y": 964.5019086453408,
      "width": 560.259521484375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b00",
      "roundness": null,
      "seed": 274420064,
      "version": 12,
      "versionNonce": 1875306848,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "3P5kyivDEkKX3Kj9s1Xin",
          "type": "arrow"
        },
        {
          "id": "Nbw9uZHKUdnq6yEqObS5q",
          "type": "arrow"
        },
        {
          "id": "oIx5ARJNhB2cDr5uizYLp",
          "type": "arrow"
        }
      ],
      "updated": 1789447433630,
      "created": 1789447433617,
      "link": null,
      "locked": false,
      "text": "A systems programmer must satisfy three core objectives",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A systems programmer must satisfy three core objectives",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "lyaBSuo-QrvOsb_2N8wh_",
      "type": "text",
      "x": 4250.719102839626,
      "y": 1091.0543770398265,
      "width": 302.95012311353366,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b01",
      "roundness": null,
      "seed": 2141857120,
      "version": 352,
      "versionNonce": 58645664,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "3P5kyivDEkKX3Kj9s1Xin",
          "type": "arrow"
        }
      ],
      "updated": 1789447433630,
      "created": 1789447433617,
      "link": null,
      "locked": false,
      "text": "Bridge the Representation\n(Semantic) Gap: Translate\nhuman-oriented algorithms and\nhigh-level specifications into\nlow-level machine execution\nsequences",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bridge the Representation (Semantic) Gap: Translate human-oriented algorithms and high-level specifications into low-level machine execution sequences",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Bwk_BxB9a367eNqQN1WwO",
      "type": "text",
      "x": 4597.02692396538,
      "y": 1093.6789405101044,
      "width": 183.857804292729,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b02",
      "roundness": null,
      "seed": 1174305120,
      "version": 321,
      "versionNonce": 501398880,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "Nbw9uZHKUdnq6yEqObS5q",
          "type": "arrow"
        }
      ],
      "updated": 1789447433630,
      "created": 1789447433617,
      "link": null,
      "locked": false,
      "text": "Efficient Resource\nManagement:\nControl, partition,\nschedule, and\nallocate CPU time,\nmain memory,\nstorage, and I/O\nperipherals among\ncompeting\napplications",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Efficient Resource Management: Control, partition, schedule, and allocate CPU time, main memory, storage, and I/O peripherals among competing applications",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "5Wlhs9lD9OyNK8l6L2SpC",
      "type": "text",
      "x": 4866.063384681516,
      "y": 1100.3206735140388,
      "width": 283.0576786080012,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b03",
      "roundness": null,
      "seed": 1722305888,
      "version": 339,
      "versionNonce": 884623520,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "oIx5ARJNhB2cDr5uizYLp",
          "type": "arrow"
        }
      ],
      "updated": 1789447433630,
      "created": 1789447433617,
      "link": null,
      "locked": false,
      "text": "Protection and Isolation:\nEnsure that executing\nprograms cannot interfere\nwith one another's memory\nor crash the host operating\nsystem",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Protection and Isolation: Ensure that executing programs cannot interfere with one another's memory or crash the host operating system",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
