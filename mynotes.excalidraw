      "groupIds": [],
      "frameId": null,
      "index": "b5B",
      "roundness": null,
      "seed": 1022474756,
      "version": 108,
      "versionNonce": 565892668,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789618299635,
      "created": 1789616502115,
      "link": null,
      "locked": false,
      "text": "+--------------+--------------------------+------------------------------+------------------------------+\n| Aspect       | Constant (DC)            | Immediate Operand            | Literal (='value')           |\n+--------------+--------------------------+------------------------------+------------------------------+\n| Syntax       | ONE DC '5'               | ADD AREG, 5                  | ADD AREG, ='5'               |\n+--------------+--------------------------+------------------------------+------------------------------+\n| Location     | Name and location        | Embedded directly inside     | Location chosen              |\n|              | specified by programmer  | instruction payload          | automatically by assembler   |\n+--------------+--------------------------+------------------------------+------------------------------+\n| Hardware     | Standard memory          | Requires CPU hardware        | Works on any architecture    |\n| Need         | addressing               | immediate mode support       | without hardware support     |\n+--------------+--------------------------+------------------------------+------------------------------+\n| Protection   | Not protected: Value     | Fixed inside instruction     | Protected: Programmer        |\n|              | can be accidentally      | bit field                    | cannot overwrite address     |\n|              | overwritten by MOVEM     |                              | directly                     |\n+--------------+--------------------------+------------------------------+------------------------------+",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "+--------------+--------------------------+------------------------------+------------------------------+\n| Aspect       | Constant (DC)            | Immediate Operand            | Literal (='value')           |\n+--------------+--------------------------+------------------------------+------------------------------+\n| Syntax       | ONE DC '5'               | ADD AREG, 5                  | ADD AREG, ='5'               |\n+--------------+--------------------------+------------------------------+------------------------------+\n| Location     | Name and location        | Embedded directly inside     | Location chosen              |\n|              | specified by programmer  | instruction payload          | automatically by assembler   |\n+--------------+--------------------------+------------------------------+------------------------------+\n| Hardware     | Standard memory          | Requires CPU hardware        | Works on any architecture    |\n| Need         | addressing               | immediate mode support       | without hardware support     |\n+--------------+--------------------------+------------------------------+------------------------------+\n| Protection   | Not protected: Value     | Fixed inside instruction     | Protected: Programmer        |\n|              | can be accidentally      | bit field                    | cannot overwrite address     |\n|              | overwritten by MOVEM     |                              | directly                     |\n+--------------+--------------------------+------------------------------+------------------------------+",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
