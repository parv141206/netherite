      "baseFontSize": null
    },
    {
      "id": "6HCgeaNeWj6-OpINnZkyE",
      "type": "text",
      "x": 2530.659610239446,
      "y": 670.9818610528723,
      "width": 542.153372874471,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2",
      "roundness": null,
      "seed": 577937760,
      "version": 227,
      "versionNonce": 669094240,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "z3Oa9le5yUgSvceyKCKXY",
          "type": "arrow"
        },
        {
          "id": "6Xa08VWR2CfBHt5dOFQnB",
          "type": "arrow"
        },
        {
          "id": "FK3cbuwvLfHowOm3Zbv4X",
          "type": "arrow"
        }
      ],
      "updated": 1789447433630,
      "link": null,
      "locked": false,
      "text": "Software is a structured collection of computer\nprograms, associated data, configuration parameters,\nruntime libraries, and documentation designed to\ninstruct hardware to perform specific computational\ntasks",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Software is a structured collection of computer programs, associated data, configuration parameters, runtime libraries, and documentation designed to instruct hardware to perform specific computational tasks",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1789447433616,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "U6aBN17aVwjQV4Uy2Pi5s",
      "type": "text",
      "x": 2275.9016433285365,
      "y": 863.569392712157,
      "width": 414.6766669941504,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 1918334304,
      "version": 176,
      "versionNonce": 1841476768,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "z3Oa9le5yUgSvceyKCKXY",
          "type": "arrow"
        }
      ],
      "updated": 1789447433630,
      "link": null,
      "locked": false,
      "text": "Application Software: Programs built to\nsolve specific user or business domain\nproblems (e.g., web browsers, database\nsystems, ERP packages)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Application Software: Programs built to solve specific user or business domain problems (e.g., web browsers, database systems, ERP packages)",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1789447433616,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "1dIXwDXDlUOVPf7lwuEtH",
      "type": "text",
      "x": 2710.5190484705918,
      "y": 837.2689909474168,
      "width": 347.83606286401164,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 377604448,
      "version": 641,
      "versionNonce": 1281910112,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "6Xa08VWR2CfBHt5dOFQnB",
          "type": "arrow"
        },
        {
          "id": "CNOrYgW_ZfFi2cyKztdy0",
          "type": "arrow"
        }
      ],
      "updated": 1789447433630,
      "link": null,
      "locked": false,
      "text": "System Software: Infrastructure\nsoftware built to manage computer\nhardware, provide an execution\nenvironment, and support the\ndevelopment and execution of\napplication software",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "System Software: Infrastructure software built to manage computer hardware, provide an execution environment, and support the development and execution of application software",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1789447433616,
      "labelPosition": null,
      "baseFontSize": null
    },
