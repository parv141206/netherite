      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "-dj1F9nxwq8LNdk136sDv",
      "type": "text",
      "x": 2911.175432374326,
      "y": 4074.5532559797257,
      "width": 403.9796447753906,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#d0bfff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4R",
      "roundness": null,
      "seed": 2108211332,
      "version": 46,
      "versionNonce": 1158495420,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1789615030975,
      "created": 1789615027882,
      "link": null,
      "locked": false,
      "text": "An Assembly Language is a machine-\ndependent, low-level programming language\nspecific to a certain computer system or\nfamily of computer systems",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An Assembly Language is a machine-dependent, low-level programming language specific to a certain computer system or family of computer systems",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "baTl2cVEiOmphBzPyt8n5",
      "type": "text",
      "x": 2908.6354543469824,
      "y": 4197.053255979726,
      "width": 409.0596008300781,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#d0bfff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4S",
      "roundness": null,
      "seed": 514095548,
      "version": 46,
      "versionNonce": 1258224900,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1789615030975,
      "created": 1789615027882,
      "link": null,
      "locked": false,
      "text": ". Compared to raw machine language, it\nprovides three fundamental features that\nsimplify programming",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": ". Compared to raw machine language, it provides three fundamental features that simplify programming",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
