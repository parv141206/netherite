      ],
      "updated": 1789447433630,
      "created": 1789447433616,
      "link": null,
      "locked": false,
      "text": "system software has two central responsibilities",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "system software has two central responsibilities",
