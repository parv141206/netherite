      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "zD2u9JyV0ecXXsZSb7Vlf",
      "type": "text",
      "x": 8706.603676629271,
      "y": 460.57193942282333,
      "width": 557.599609375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
