    },
    {
      "id": "yE1fCZwBEtoIUjd00vOkw",
      "type": "text",
      "x": 7890.84551739627,
      "y": 1594.3683485889048,
      "width": 649,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2g",
      "roundness": null,
      "seed": 706088540,
      "version": 388,
      "versionNonce": 2010913372,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789465530829,
      "created": 1789464501550,
      "link": null,
      "locked": false,
      "text": "A forward reference is a reference to a program entity (variable,\nlabel, routine) that occurs before the statement that defines or\ndeclares that entity in the source text.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A forward reference is a reference to a program entity (variable, label, routine) that occurs before the statement that defines or declares that entity in the source text.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
