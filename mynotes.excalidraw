      "seed": 467357372,
      "version": 229,
      "versionNonce": 1997694596,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "ABM0l4kJ9OfEAbn8OzNzy",
          "type": "arrow"
        }
      ],
      "updated": 1789618500061,
      "created": 1789617359284,
      "link": null,
      "locked": false,
      "text": "        START 200\n        MOVER AREG, ='5'\n        MOVEM AREG, M\nL1      MOVER AREG, ='2'\n        ORIGIN L1+3\n        LTORG\nNEXT    ADD   AREG, ='1'\n        SUB   BREG, ='2'\n        BC    LT, BACK\n        LTORG\nBACK    EQU   L1\n        ORIGIN NEXT+5\n        MULT  CREG, ='4'\n        STOP\nM       DS    1\n        END",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "        START 200\n        MOVER AREG, ='5'\n        MOVEM AREG, M\nL1      MOVER AREG, ='2'\n        ORIGIN L1+3\n        LTORG\nNEXT    ADD   AREG, ='1'\n        SUB   BREG, ='2'\n        BC    LT, BACK\n        LTORG\nBACK    EQU   L1\n        ORIGIN NEXT+5\n        MULT  CREG, ='4'\n        STOP\nM       DS    1\n        END",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "tI-JxMrIzuF8XnLLf0nrU",
      "type": "text",
      "x": 5886.462128652651,
      "y": 5374.431380471646,
      "width": 1011.9990844726562,
      "height": 500,
