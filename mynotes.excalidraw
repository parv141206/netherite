    {
      "id": "PMxwShP1pasXofaaWpgCg",
      "type": "text",
      "x": 5943.216509482665,
      "y": 4752.428645797735,
      "width": 1121.999267578125,
      "height": 575,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff4e6",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5z",
