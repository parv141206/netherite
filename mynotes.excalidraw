      "link": null,
      "locked": false,
      "text": "To handle forward references cleanly, a Two-Pass Assembler splits the translation into two scans",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "To handle forward references cleanly, a Two-Pass Assembler splits the translation into two scans",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "h7vukA5wFwg8TW3WWlpzl",
      "type": "text",
      "x": 5283.296647662182,
      "y": 4608.720963506068,
      "width": 736.9990234375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff4e6",
