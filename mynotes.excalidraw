      "isDeleted": false,
      "boundElements": [],
      "updated": 1789465418211,
      "link": null,
      "locked": false,
      "text": " Programming Languages and Language Processors, Language Processing\nActivities, Program Execution,",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " Programming Languages and Language Processors, Language Processing\nActivities, Program Execution,",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1789463458177,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "E4c9ch-h-SK9PXA1I5-Pd",
      "type": "text",
      "x": 8257.459720615097,
      "y": 49.32618238128924,
      "width": 909.7193603515625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1t",
      "roundness": null,
      "seed": 382850396,
      "version": 357,
      "versionNonce": 961931612,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789465418211,
      "created": 1789463500166,
      "link": null,
      "locked": false,
      "text": "Language Processing = Analysis of Source Program (SP) + Synthesis of Target Program (TP)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Language Processing = Analysis of Source Program (SP) + Synthesis of Target Program (TP)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "QfSlo51u07wx0QYvNle40",
      "type": "text",
      "x": 8067.969912324883,
      "y": 132.38866489856412,
      "width": 590.7044637949057,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1u",
      "roundness": null,
      "seed": 1605787108,
      "version": 369,
      "versionNonce": 839409116,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789465418211,
      "created": 1789463579970,
      "link": null,
      "locked": false,
      "text": "To make compilers modular and portable, modern systems\nsoftware cleanly separates the Analysis phase from the\nSynthesis phase:",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "To make compilers modular and portable, modern systems software cleanly separates the Analysis phase from the Synthesis phase:",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "8kgpl10tRMT6PbiPKYwr7",
      "type": "text",
      "x": 8087.839903892269,
      "y": 234.3459402758159,
      "width": 1132.95849609375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1v",
      "roundness": null,
      "seed": 407407332,
      "version": 260,
      "versionNonce": 1165509212,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "YuhXt68NBznmcL8ZdgAqv",
          "type": "arrow"
        },
        {
          "id": "0rJe2uObS7hk6L-Ljmmqq",
          "type": "arrow"
        }
      ],
      "updated": 1789465418211,
      "created": 1789463593240,
      "link": null,
      "locked": false,
      "text": "Source Code ──► [ FRONT END (Analysis) ] ──► IR + Tables ──► [ BACK END (Synthesis) ] ──► Target Code\n                  (Language-Dependent)                          (Machine-Dependent)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Source Code ──► [ FRONT END (Analysis) ] ──► IR + Tables ──► [ BACK END (Synthesis) ] ──► Target Code\n                  (Language-Dependent)                          (Machine-Dependent)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "xQKnw8hAJOJS-9EkP_3aF",
      "type": "text",
      "x": 8102.727152620988,
      "y": 378.328702249494,
      "width": 537.03955078125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1w",
      "roundness": null,
      "seed": 1819173468,
      "version": 351,
      "versionNonce": 444045020,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "YuhXt68NBznmcL8ZdgAqv",
          "type": "arrow"
        }
      ],
      "updated": 1789465418211,
      "created": 1789463619060,
      "link": null,
      "locked": false,
      "text": "Responsibility: Concerned exclusively with the rules and\nabstractions of the Source Language.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Responsibility: Concerned exclusively with the rules and abstractions of the Source Language.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "fxNzTg8Y5T5YqgOFKjOhB",
      "type": "text",
      "x": 8101.654823742298,
      "y": 451.5164041737464,
      "width": 526.779541015625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1x",
      "roundness": null,
      "seed": 159272412,
      "version": 277,
      "versionNonce": 764959580,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789465418211,
      "created": 1789463629190,
      "link": null,
      "locked": false,
      "text": "Key Tasks: Lexical Analysis, Syntax Analysis, Semantic\nAnalysis, and IR generation.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Key Tasks: Lexical Analysis, Syntax Analysis, Semantic Analysis, and IR generation.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "4CVH7KcLDRzST-gk0ZyYz",
      "type": "text",
      "x": 8076.832914775243,
      "y": 529.3226797797678,
      "width": 587.339599609375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1y",
      "roundness": null,
      "seed": 1666378468,
      "version": 290,
      "versionNonce": 422350812,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789465418211,
      "created": 1789463652925,
      "link": null,
      "locked": false,
      "text": "Portability Benefit: If you want to support a new language\n(e.g., Rust) on an existing machine, you only need to write a\nnew Front End that generates the standard IR!",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Portability Benefit: If you want to support a new language (e.g., Rust) on an existing machine, you only need to write a new Front End that generates the standard IR!",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
