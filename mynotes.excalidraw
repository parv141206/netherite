      "version": 237,
      "versionNonce": 2029216928,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "QBPusX8eNbqyOp0eWHawe",
          "type": "arrow"
        }
      ],
      "updated": 1789447433630,
      "created": 1789447433616,
      "link": null,
      "locked": false,
      "text": "Bridge the Representation (Semantic) Gap:\nTranslate human-centric specifications (high-\nlevel language instructions, algorithms, queries)\ninto low-level machine execution actions\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bridge the Representation (Semantic) Gap: Translate human-centric specifications (high-level language instructions, algorithms, queries) into low-level machine execution actions\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
