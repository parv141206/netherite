      "isDeleted": false,
      "boundElements": null,
      "updated": 1789616712657,
      "created": 1789616261464,
      "link": null,
      "locked": false,
      "text": "Example: A DS 1 (reserves 1 word);",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Example: A DS 1 (reserves 1 word);",
