# ==========================================
# NETHERITE ENVIRONMENT CONFIGURATION
# ==========================================

# NextAuth Secret (Generate with: openssl rand -base64 32 or npx auth secret)
AUTH_SECRET="your-32-byte-secret-here"
AUTH_TRUST_HOST="true"

# Google OAuth 2.0 Credentials (Google Cloud Console -> APIs & Services -> Credentials)
# Enabled APIs: Google Drive API
# Authorized JavaScript Origins:
#   - http://localhost:3000
#   - https://<your-project>.vercel.app
# Authorized Redirect URIs:
#   - http://localhost:3000/api/auth/callback/google
#   - https://<your-project>.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID="your-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-client-secret"

# Zero Database Architecture:
# Notes, folders, assets, and metadata reside 100% in your Google Drive (/netherite).
# Authentication sessions use encrypted JWT tokens. No database required!

# Production Base URL (Optional on Vercel, automatically handled)
# NEXTAUTH_URL="https://your-domain.com"
