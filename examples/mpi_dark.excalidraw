        "grp_mu42d041_1"
      ],
      "roundness": null,
      "seed": 391875,
      "version": 1,
      "versionNonce": 943251,
      "isDeleted": false,
      "text": "Internal vs External System Operations",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42d03x-4"
    },
    {
      "id": "sub-mu42d03x-4-note",
      "type": "text",
      "x": -172,
      "y": -450,
      "width": 314,
      "height": 190,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_1"
      ],
      "roundness": null,
      "seed": 395427,
      "version": 1,
      "versionNonce": 715710,
      "isDeleted": false,
      "text": "A microprocessor is an active digital\nlogic device executing programs stored\nin memory. Its operations divide into\ntwo domains: Internal Operations\nexecuted within the CPU architecture\n(ALU operations, register transfers,\nflag updates, instruction decoding), and\nExternal Bus Operations communicating\nacross system buses with memory chips\nand I/O peripherals.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "sub-mu42d03x-13",
      "type": "rectangle",
