      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_4"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 55052,
      "version": 1,
      "versionNonce": 84038,
      "isDeleted": false,
      "boundElements": [
