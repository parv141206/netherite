          "type": "text"
        }
      ]
    },
    {
      "id": "sub-mu42d03x-34_text",
      "type": "text",
      "x": -193,
      "y": 2488,
      "width": 386,
      "height": 22,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
