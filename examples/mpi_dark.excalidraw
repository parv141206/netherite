        "grp_mu42d041_3"
      ],
      "roundness": null,
      "seed": 804886,
      "version": 1,
      "versionNonce": 308418,
      "isDeleted": false,
      "text": "Fundamental Addressability Formulation",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42d03x-34"
    },
    {
      "id": "sub-mu42d03x-34-note",
      "type": "text",
      "x": -168,
      "y": 2252,
      "width": 306,
      "height": 171,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_3"
      ],
      "roundness": null,
      "seed": 302502,
      "version": 1,
      "versionNonce": 295260,
      "isDeleted": false,
      "text": "The relationship between address lines\n(N) and uniquely addressable memory\nlocations (M) is strictly M = 2^N. With\nbyte-wide storage (8 bits/location),\ntotal capacity equals 2^N bytes. 10\nlines address 1 KB (1024 B), 12 lines\naddress 4 KB (4096 B), 16 lines address\n64 KB (full 8085 space), and 20 lines\naddress 1 MB (full 8086 space).",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "sub-mu42d03x-36",
      "type": "rectangle",
      "x": -787,
      "y": 2542,
      "width": 410,
      "height": 51,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "#212529",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
