    {
      "id": "flow-mu42d03x-68",
      "type": "rectangle",
      "x": 40,
      "y": 5294,
      "width": 376,
      "height": 49,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "#1a1a1f",
