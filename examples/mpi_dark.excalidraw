    },
    {
      "id": "flow-mu42d03x-23_text",
      "type": "text",
      "x": -364,
      "y": 1686,
      "width": 314,
      "height": 20,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_2"
      ],
      "roundness": null,
      "seed": 157435,
      "version": 1,
      "versionNonce": 29072,
      "isDeleted": false,
      "text": "Static RAM (SRAM 6-Transistor Cell)",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "flow-mu42d03x-23"
    },
    {
      "id": "flow-mu42d03x-25",
      "type": "rectangle",
      "x": 40,
      "y": 1671,
      "width": 301,
      "height": 49,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "#1a1a1f",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_2"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 388684,
      "version": 1,
      "versionNonce": 796116,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "flow-mu42d03x-25_text",
          "type": "text"
        }
      ]
    },
    {
      "id": "flow-mu42d03x-25_text",
      "type": "text",
      "x": 50,
      "y": 1686,
      "width": 281,
      "height": 20,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_2"
      ],
      "roundness": null,
      "seed": 615540,
      "version": 1,
      "versionNonce": 305785,
      "isDeleted": false,
      "text": "Dynamic RAM (DRAM 1-T 1-C Cell)",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "flow-mu42d03x-25"
    },
    {
      "id": "sub-mu42d03x-21-note",
      "type": "text",
      "x": -709,
      "y": 1671,
      "width": 275,
      "height": 95,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_2"
      ],
      "roundness": null,
      "seed": 979384,
      "version": 1,
      "versionNonce": 505782,
      "isDeleted": false,
      "text": "RAM permits both read and write\naccess with identical access\nlatency across all locations. It is\nvolatile, losing data when power is\nremoved.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "flow-mu42d03x-23-note",
      "type": "text",
      "x": -371,
      "y": 1763,
      "width": 298,
      "height": 133,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_2"
      ],
      "roundness": null,
      "seed": 314493,
      "version": 1,
      "versionNonce": 744253,
      "isDeleted": false,
      "text": "SRAM stores each bit in a bistable\nmulti-transistor flip-flop (6 MOS\ntransistors per cell). It requires no\nrefresh cycles and offers ultra-fast\naccess (10-30 ns), making it ideal for\nCPU caches (L1/L2/L3) and scratchpads\ndespite higher cost and lower density.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "flow-mu42d03x-25-note",
      "type": "text",
      "x": 49,
      "y": 1763,
      "width": 314,
      "height": 133,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_2"
      ],
      "roundness": null,
      "seed": 336611,
      "version": 1,
      "versionNonce": 166680,
      "isDeleted": false,
      "text": "DRAM stores each bit as charge on a tiny\nMOS gate capacitance (1 transistor + 1\ncapacitor). Dielectric leakage requires\nperiodic refresh cycles every 2-4 ms. It\ndelivers massive density and low cost\nfor main system RAM (DDR4/DDR5) with\n50-100 ns access latency.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "diagram-mu42d03x-27",
      "type": "rectangle",
      "x": 560,
      "y": 1651,
      "width": 695,
      "height": 421,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "#141517",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_2"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 535482,
      "version": 1,
      "versionNonce": 753934,
      "isDeleted": false
    },
    {
      "id": "diagram-mu42d03x-27_code",
      "type": "text",
      "x": 572,
      "y": 1663,
      "width": 671,
      "height": 397,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_2"
      ],
      "roundness": null,
      "seed": 838119,
      "version": 1,
      "versionNonce": 352164,
      "isDeleted": false,
      "text": "+-----------------------------------------------------------------------------------+\n|                           MEMORY CLASSIFICATION TREE                              |\n+-----------------------------------------------------------------------------------+\n                                         |\n         +-------------------------------+-------------------------------+\n         |                                                               |\n         v                                                               v\n+---------------------------------+             +---------------------------------+\n|   PRIMARY SEMICONDUCTOR MEMORY  |             |    SECONDARY STORAGE (MASS)     |\n+---------------------------------+             +---------------------------------+\n         |                                                       |\n   +-----+-----+                                           +-----+-----+\n   |           |                                           |           |\n   v           v                                           v           v\n+-----+     +-----+                                     +-------+   +-------+\n| RAM |     | ROM |                                     |MAGNETIC|  |OPTICAL|\n+-----+     +-----+                                     +-------+   +-------+\n   |           |                                            |           |\n   |-- SRAM    |-- Masked ROM                               |-- HDD     |-- CD-ROM\n   |-- DRAM    |-- PROM                                     |-- Tape    |-- CD-R\n               |-- EPROM                                                |-- CD-RW\n               |-- EEPROM                                               |-- DVD\n               |-- Flash Memory",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top"
    },
