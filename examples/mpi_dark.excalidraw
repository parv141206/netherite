        }
      ]
    },
    {
      "id": "sub-mu42d03x-48_text",
      "type": "text",
      "x": -236,
      "y": 3681,
      "width": 472,
      "height": 22,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_4"
      ],
      "roundness": null,
      "seed": 108601,
      "version": 1,
      "versionNonce": 923143,
      "isDeleted": false,
      "text": "Four Physical Constraints Mandating Interfacing",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42d03x-48"
    },
    {
      "id": "sub-mu42d03x-48-note",
      "type": "text",
      "x": -172,
      "y": 3389,
      "width": 314,
      "height": 227,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_4"
      ],
      "roundness": null,
      "seed": 725242,
      "version": 1,
      "versionNonce": 49284,
      "isDeleted": false,
      "text": "Peripherals cannot wire directly to the\nCPU bus due to four critical hardware\nconstraints: 1. Speed Mismatch (CPU\noperates in sub-microsecond cycles while\nmechanical I/O takes milliseconds); 2.\nSignal & Voltage Incompatibility (TTL\n+5V vs 24V industrial or analog\nvoltages); 3. Transient Data Bus (CPU\noutput data is valid for only ~300 ns\nduring T2-T3); 4. Bus Contention\n(unbuffered inputs would short-circuit\nthe shared data bus).",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "sub-mu42d03x-50",
      "type": "rectangle",
      "x": -939,
      "y": 3735,
      "width": 525,
      "height": 51,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "#212529",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_4"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 865539,
      "version": 1,
      "versionNonce": 903842,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "sub-mu42d03x-50_text",
          "type": "text"
        }
      ]
    },
    {
      "id": "sub-mu42d03x-50_text",
      "type": "text",
      "x": -927,
      "y": 3750,
      "width": 501,
      "height": 22,
      "angle": 0,
      "strokeColor": "#f8f9fa",
