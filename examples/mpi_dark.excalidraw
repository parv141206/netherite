      "versionNonce": 883744,
      "isDeleted": false,
      "text": "Random Access Memory (RAM Technologies)",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42d03x-21"
    },
    {
