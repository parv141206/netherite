        "grp_mu42d041_4"
      ],
      "roundness": null,
      "seed": 814319,
      "version": 1,
      "versionNonce": 433796,
      "isDeleted": false,
      "text": "Input Port Interfacing: Tri-State Buffer (74LS244)",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42d03x-50"
    },
    {
      "id": "sub-mu42d03x-59",
      "type": "rectangle",
      "x": -767,
      "y": 3906,
      "width": 353,
      "height": 51,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "#212529",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_4"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 115244,
      "version": 1,
      "versionNonce": 414838,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "sub-mu42d03x-59_text",
          "type": "text"
        }
      ]
    },
    {
      "id": "sub-mu42d03x-59_text",
      "type": "text",
      "x": -755,
      "y": 3921,
      "width": 329,
      "height": 22,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_4"
      ],
      "roundness": null,
      "seed": 579573,
      "version": 1,
      "versionNonce": 705382,
      "isDeleted": false,
      "text": "Solved GTU Interfacing Questions",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42d03x-59"
    },
    {
      "id": "sub-mu42d03x-50-note",
      "type": "text",
      "x": -1303,
      "y": 3720,
      "width": 314,
      "height": 152,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_4"
      ],
      "roundness": null,
      "seed": 171288,
      "version": 1,
      "versionNonce": 428001,
      "isDeleted": false,
      "text": "Input peripherals must connect through\noctal tri-state buffers (IC 74LS244).\nWhen active-low OE' is high, outputs\nremain in High-Impedance (Z), completely\nisolating the peripheral from the data\nbus. During an active I/O read cycle,\naddress decoding and RD' assert OE'=0,\ncleanly routing port data onto D7-D0.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "sub-mu42d03x-59-note",
      "type": "text",
      "x": -1146,
      "y": 3906,
      "width": 314,
      "height": 171,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_4"
      ],
      "roundness": null,
      "seed": 500005,
      "version": 1,
      "versionNonce": 672731,
      "isDeleted": false,
      "text": "GTU Winter 2024: Latches provide\nessential temporary-to-static data\nholding for output peripherals,\nresolving data bus transient decay.\nTri-state buffers eliminate electrical\nbus contention during multi-device input\nmultiplexing by enforcing High-Impedance\nisolation until an authorized read\nstrobe occurs.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "sub-mu42d03x-52",
      "type": "rectangle",
      "x": -243,
      "y": 4066,
      "width": 486,
      "height": 51,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "#212529",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_4"
