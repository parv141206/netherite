        }
      ]
    },
    {
      "id": "flow-mu42d03x-68_text",
      "type": "text",
      "x": 50,
      "y": 5309,
      "width": 356,
      "height": 20,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
