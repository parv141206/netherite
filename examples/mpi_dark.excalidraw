    },
    {
      "id": "flow-mu42d03x-44",
      "type": "rectangle",
      "x": 40,
      "y": 2994,
      "width": 460,
      "height": 49,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "#1a1a1f",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_3"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 582715,
      "version": 1,
      "versionNonce": 518868,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "flow-mu42d03x-44_text",
          "type": "text"
        }
      ]
    },
    {
      "id": "flow-mu42d03x-44_text",
      "type": "text",
      "x": 50,
      "y": 3009,
      "width": 440,
      "height": 20,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_3"
      ],
      "roundness": null,
      "seed": 259909,
      "version": 1,
      "versionNonce": 929115,
      "isDeleted": false,
      "text": "Higher Address Line Decoding (A13-A12 via 74LS138)",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "flow-mu42d03x-44"
    },
    {
      "id": "sub-mu42d03x-40-note",
      "type": "text",
      "x": -793,
      "y": 2994,
      "width": 275,
      "height": 152,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_3"
      ],
      "roundness": null,
      "seed": 521880,
      "version": 1,
      "versionNonce": 313913,
      "isDeleted": false,
      "text": "A 16 KB microcomputer system built\nfrom 4 KB x 8 chips requires:\nNumber of chips = (16 KB x 8) / (4\nKB x 8) = 4 chips. Address lines\nper individual chip = 2^12 = 12\nlines (A11-A0). Address lines for\ntotal 16 KB space = 2^14 = 14 lines\n(A13-A0).",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "flow-mu42d03x-42-note",
      "type": "text",
      "x": -421,
      "y": 3086,
      "width": 314,
      "height": 95,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_3"
      ],
      "roundness": null,
      "seed": 884101,
      "version": 1,
      "versionNonce": 878235,
      "isDeleted": false,
      "text": "Address lines A11 through A0 connect in\nparallel to all 4 memory chips to\nprovide internal 12-bit word indexing\nacross 4096 memory registers within each\nchip.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "flow-mu42d03x-44-note",
      "type": "text",
      "x": 140,
      "y": 3086,
      "width": 291,
      "height": 95,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_3"
      ],
      "roundness": null,
      "seed": 381571,
      "version": 1,
      "versionNonce": 53702,
      "isDeleted": false,
      "text": "Higher address lines A13 and A12 feed\ndirectly into a 2-to-4 line decoder\n(74LS138) to generate 4 distinct,\nmutually exclusive active-low Chip\nEnable (CE') strobe signals.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "diagram-mu42d03x-46",
      "type": "rectangle",
      "x": 600,
      "y": 2974,
      "width": 836,
      "height": 235,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "#141517",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_3"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 648722,
      "version": 1,
      "versionNonce": 190172,
      "isDeleted": false
    },
    {
      "id": "diagram-mu42d03x-46_code",
      "type": "text",
      "x": 612,
      "y": 2986,
      "width": 812,
      "height": 211,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42d041_3"
      ],
      "roundness": null,
      "seed": 931569,
      "version": 1,
      "versionNonce": 508398,
      "isDeleted": false,
      "text": "+---------------+-------------------+----------------------+------------------------------------------+\n| ADDRESS LINES | CAPACITY FORMULA  | TOTAL BYTES          | INDUSTRY UNIT NOTATION                   |\n+---------------+-------------------+----------------------+------------------------------------------+\n| N = 10 lines  | 2^10 bytes        | 1,024 bytes          | 1 Kilobyte (1 KB)                        |\n| N = 11 lines  | 2^11 = 2 x 2^10   | 2,048 bytes          | 2 Kilobytes (2 KB)                       |\n| N = 12 lines  | 2^12 = 4 x 2^10   | 4,096 bytes          | 4 Kilobytes (4 KB)                       |\n| N = 13 lines  | 2^13 = 8 x 2^10   | 8,192 bytes          | 8 Kilobytes (8 KB)                       |\n| N = 14 lines  | 2^14 = 16 x 2^10  | 16,384 bytes         | 16 Kilobytes (16 KB)                     |\n| N = 15 lines  | 2^15 = 32 x 2^10  | 32,768 bytes         | 32 Kilobytes (32 KB)                     |\n| N = 16 lines  | 2^16 = 64 x 2^10  | 65,536 bytes         | 64 Kilobytes (64 KB) -> Full 8085 Space  |\n| N = 20 lines  | 2^20 = 1 x 2^20   | 1,048,576 bytes      | 1 Megabyte (1 MB) -> Full 8086 Space     |\n+---------------+-------------------+----------------------+------------------------------------------+",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top"
    },
