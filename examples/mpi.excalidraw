      ]
    },
    {
      "id": "flow-mu42zdxy-10_text",
      "type": "text",
      "x": 50,
      "y": 326,
      "width": 264,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
