    {
      "id": "sub-mu42cwom-19_text",
      "type": "text",
      "x": -207,
      "y": 1165,
      "width": 415,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42cwoq_2"
      ],
      "roundness": null,
      "seed": 427768,
      "version": 1,
      "versionNonce": 282414,
      "isDeleted": false,
      "text": "Primary Semiconductor Memory Architecture",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42cwom-19"
    },
    {
      "id": "sub-mu42cwom-19-note",
      "type": "text",
      "x": -168,
      "y": 967,
      "width": 306,
      "height": 133,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42cwoq_2"
      ],
      "roundness": null,
      "seed": 488044,
      "version": 1,
      "versionNonce": 160849,
      "isDeleted": false,
      "text": "Semiconductor memory is an array of\nstorage cells organized as words\n(bytes). Each location has a unique\nbinary address. Primary memory is split\ninto volatile Read/Write Random Access\nMemory (RAM) and non-volatile Read-Only\nMemory (ROM).",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "sub-mu42cwom-28",
      "type": "rectangle",
      "x": -784,
      "y": 1219,
      "width": 382,
      "height": 51,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu42cwoq_2"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 106650,
      "version": 1,
      "versionNonce": 877420,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "sub-mu42cwom-28_text",
          "type": "text"
        }
      ]
    },
    {
      "id": "sub-mu42cwom-28_text",
