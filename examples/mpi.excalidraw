        }
      ]
    },
    {
      "id": "flow-mu42zdxy-68_text",
      "type": "text",
      "x": 50,
      "y": 5174,
      "width": 356,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_5"
      ],
      "roundness": null,
      "seed": 823027,
      "version": 1,
      "versionNonce": 420761,
      "isDeleted": false,
      "text": "Dedicated 8-Bit Isolated Port Addressing",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "flow-mu42zdxy-68"
    },
    {
      "id": "sub-mu42zdxy-64-note",
      "type": "text",
      "x": -743,
      "y": 5159,
      "width": 275,
      "height": 227,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_5"
      ],
      "roundness": null,
      "seed": 600413,
      "version": 1,
      "versionNonce": 419840,
      "isDeleted": false,
      "text": "In Peripheral-Mapped (Isolated)\nI/O, the CPU maintains two\ncompletely separate address spaces:\n64 KB for Memory and 256\nindependent ports for I/O. Ports\nuse 8-bit addresses (A7-A0\nduplicated on A15-A8). The CPU\nasserts IO/M'=1, generating IOR'\nand IOW' strobes. Access is\nstrictly limited to IN and OUT\ninstructions passing through the\nAccumulator.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-sub-mu42zdxy-64-sub-mu42zdxy-64-note",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "flow-mu42zdxy-66-note",
      "type": "text",
      "x": -396,
      "y": 5251,
      "width": 314,
      "height": 114,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_5"
      ],
      "roundness": null,
      "seed": 927677,
      "version": 1,
      "versionNonce": 391538,
      "isDeleted": false,
      "text": "CPU drives 16-bit address on A15-A0 with\nIO/M'=0. Any internal register (A, B, C,\nD, E, H, L) can serve as source or\ndestination, and arithmetic/logical\noperations (ADD M, CMP M) execute\ndirectly on port data.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-flow-mu42zdxy-66-flow-mu42zdxy-66-note",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "flow-mu42zdxy-68-note",
      "type": "text",
      "x": 86,
      "y": 5251,
      "width": 314,
      "height": 133,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_5"
      ],
      "roundness": null,
      "seed": 197462,
      "version": 1,
      "versionNonce": 308740,
      "isDeleted": false,
      "text": "CPU drives 8-bit port address with\nIO/M'=1. Data transfer is strictly\nrestricted through Accumulator Register\nA via IN port_addr (10 T-states) and OUT\nport_addr (10 T-states), leaving the\nentire 64 KB address space available for\nRAM and ROM.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-flow-mu42zdxy-68-flow-mu42zdxy-68-note",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "diagram-mu42zdxy-70",
      "type": "rectangle",
      "x": 560,
      "y": 5139,
      "width": 695,
      "height": 320,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_5"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 418955,
      "version": 1,
      "versionNonce": 590875,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "edge-flow-mu42zdxy-68-diagram-mu42zdxy-70",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "diagram-mu42zdxy-70_code",
      "type": "text",
      "x": 572,
      "y": 5151,
      "width": 671,
      "height": 296,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_5"
      ],
      "roundness": null,
      "seed": 768434,
      "version": 1,
      "versionNonce": 867597,
      "isDeleted": false,
      "text": "+-----------------------------------------------------------------------------------+\n|                    ADDRESS SPACE ALLOCATION ARCHITECTURE                          |\n+-----------------------------------------------------------------------------------+\n      MEMORY-MAPPED I/O (Unified Space)           ISOLATED I/O (Separated Spaces)\n      \n          FFFFH +-----------------+                   FFFFH +-----------------+\n                |   RAM Memory    |                         |                 |\n                |                 |                         |   64 KB Full    |\n          8000H +-----------------+                         |   Memory Space  |\n                | I/O Port Space  |                         |  (RAM and ROM)  |\n          7FFFH +-----------------+                         |                 |\n                |   ROM Memory    |                   0000H +-----------------+\n                |                 |\n          0000H +-----------------+                   FFH   +-----------------+\n                                                            | 256 I/O Ports   |\n          (Total Space = 64 KB Shared)                00H   +-----------------+\n                                                            (Dedicated I/O Space)",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top"
    },
