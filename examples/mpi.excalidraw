      "versionNonce": 44644,
      "isDeleted": false,
      "text": "Random Access Memory (RAM Technologies)",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42cwom-21"
    },
    {
      "id": "flow-mu42cwom-23",
