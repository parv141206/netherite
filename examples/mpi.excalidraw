      ],
      "roundness": {
        "type": 3
      },
      "seed": 588834,
      "version": 1,
      "versionNonce": 82206,
      "isDeleted": false
    },
    {
      "id": "diagram-mu42cwom-58_code",
      "type": "text",
      "x": 572,
      "y": 4179,
      "width": 656,
      "height": 262,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42cwoq_4"
      ],
      "roundness": null,
      "seed": 941715,
      "version": 1,
      "versionNonce": 444188,
      "isDeleted": false,
      "text": "   INPUT PORT (Tri-State Buffer - 74LS244)          OUTPUT PORT (Latch - 74LS373)\n   \n        Peripheral Input Data                         CPU Data Bus (D7 - D0)\n                 |                                               |\n                 v                                               v\n        +-----------------+                             +-----------------+\n        |  Tri-State Gate |                             |    D-Latch      |\n        +-----------------+                             +-----------------+\n                 |                                               |\n    Enable Pulse | (Active LOW)                     Clock Pulse  | (Falling Edge)\n    from Address +----------------+                 from Address +----------------+\n    Decoder & RD'                 |                 Decoder & WR'                 |\n                 v                |                              v                |\n         CPU Data Bus (D7-D0)     |                      Peripheral Output Pins   |\n    (Enabled ONLY during Read)    |                 (Holds data continuously)     |",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "topic-mu42cwom-61",
