    },
    {
      "id": "topic-mu42zdxy-1-note",
      "type": "text",
      "x": 327,
      "y": -46,
      "width": 320,
      "height": 183,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_1"
      ],
      "roundness": null,
      "seed": 141937,
      "version": 1,
      "versionNonce": 791488,
      "isDeleted": false,
      "text": "**Subject Code:** BE05000551 / 3160712\n(Microprocessor and Interfacing - MPI)\n\n**Standard References:** Ramesh S.\nGaonkar (*Microprocessor Architecture,\nProgramming, and Applications with the\n8085*) + Darshan Institute GTU Notes\n(Unit 2) + GTU Past Examination Papers\n(2021–2025)",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-topic-mu42zdxy-1-topic-mu42zdxy-1-note",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "sub-mu42zdxy-4",
