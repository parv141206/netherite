      "roundness": null,
      "seed": 370927,
      "version": 1,
      "versionNonce": 554887,
      "isDeleted": false,
      "text": "+----------------+      1. Place 16-bit Address      +----------------------+\n|                |==================================>|                      |\n|                |                                   |  Memory / I/O Port   |\n|                |      2. Assert RD' = 0 (Pulse)    |      Selection       |\n|  Intel 8085    |---------------------------------->|   (Address Decoder)  |\n| Microprocessor |                                   |                      |\n|                |      3. Drive Data on Data Bus    |                      |\n|                |<==================================|                      |\n|                |              (D7 - D0)            +----------------------+\n+----------------+",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top"
    },
