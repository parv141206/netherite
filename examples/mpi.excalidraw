        "grp_mu42zdy2_3"
      ],
      "roundness": null,
      "seed": 33718,
      "version": 1,
      "versionNonce": 442404,
      "isDeleted": false,
      "text": "Higher Address Line Decoding (A13-A12 via 74LS138)",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "flow-mu42zdxy-44"
    },
    {
      "id": "sub-mu42zdxy-40-note",
      "type": "text",
      "x": -793,
      "y": 2859,
      "width": 275,
      "height": 152,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_3"
      ],
      "roundness": null,
      "seed": 420476,
      "version": 1,
      "versionNonce": 944126,
      "isDeleted": false,
      "text": "A 16 KB microcomputer system built\nfrom 4 KB x 8 chips requires:\nNumber of chips = (16 KB x 8) / (4\nKB x 8) = 4 chips. Address lines\nper individual chip = 2^12 = 12\nlines (A11-A0). Address lines for\ntotal 16 KB space = 2^14 = 14 lines\n(A13-A0).",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-sub-mu42zdxy-40-sub-mu42zdxy-40-note",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "flow-mu42zdxy-42-note",
      "type": "text",
      "x": -421,
      "y": 2951,
      "width": 314,
      "height": 95,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_3"
      ],
      "roundness": null,
      "seed": 163541,
      "version": 1,
      "versionNonce": 327535,
      "isDeleted": false,
      "text": "Address lines A11 through A0 connect in\nparallel to all 4 memory chips to\nprovide internal 12-bit word indexing\nacross 4096 memory registers within each\nchip.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-flow-mu42zdxy-42-flow-mu42zdxy-42-note",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "flow-mu42zdxy-44-note",
      "type": "text",
      "x": 140,
      "y": 2951,
      "width": 291,
      "height": 95,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_3"
      ],
      "roundness": null,
      "seed": 221554,
      "version": 1,
      "versionNonce": 943912,
      "isDeleted": false,
      "text": "Higher address lines A13 and A12 feed\ndirectly into a 2-to-4 line decoder\n(74LS138) to generate 4 distinct,\nmutually exclusive active-low Chip\nEnable (CE') strobe signals.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-flow-mu42zdxy-44-flow-mu42zdxy-44-note",
          "type": "arrow"
        }
      ]
    },
    {
