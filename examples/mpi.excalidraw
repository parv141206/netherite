        }
      ]
    },
    {
      "id": "sub-mu42cwom-48_text",
      "type": "text",
      "x": -236,
      "y": 3681,
      "width": 472,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42cwoq_4"
      ],
      "roundness": null,
      "seed": 205619,
      "version": 1,
      "versionNonce": 213398,
      "isDeleted": false,
      "text": "Four Physical Constraints Mandating Interfacing",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42cwom-48"
    },
    {
      "id": "sub-mu42cwom-48-note",
      "type": "text",
      "x": -172,
      "y": 3389,
      "width": 314,
      "height": 227,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42cwoq_4"
      ],
      "roundness": null,
      "seed": 844105,
      "version": 1,
      "versionNonce": 50973,
      "isDeleted": false,
      "text": "Peripherals cannot wire directly to the\nCPU bus due to four critical hardware\nconstraints: 1. Speed Mismatch (CPU\noperates in sub-microsecond cycles while\nmechanical I/O takes milliseconds); 2.\nSignal & Voltage Incompatibility (TTL\n+5V vs 24V industrial or analog\nvoltages); 3. Transient Data Bus (CPU\noutput data is valid for only ~300 ns\nduring T2-T3); 4. Bus Contention\n(unbuffered inputs would short-circuit\nthe shared data bus).",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "sub-mu42cwom-50",
      "type": "rectangle",
      "x": -939,
      "y": 3735,
      "width": 525,
      "height": 51,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu42cwoq_4"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 162739,
      "version": 1,
      "versionNonce": 254611,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "sub-mu42cwom-50_text",
          "type": "text"
        }
      ]
    },
    {
      "id": "sub-mu42cwom-50_text",
      "type": "text",
      "x": -927,
      "y": 3750,
      "width": 501,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42cwoq_4"
      ],
      "roundness": null,
      "seed": 871377,
      "version": 1,
      "versionNonce": 194023,
      "isDeleted": false,
      "text": "Input Port Interfacing: Tri-State Buffer (74LS244)",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42cwom-50"
    },
    {
      "id": "sub-mu42cwom-59",
      "type": "rectangle",
      "x": -767,
      "y": 3906,
      "width": 353,
      "height": 51,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu42cwoq_4"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 754894,
      "version": 1,
      "versionNonce": 990396,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "sub-mu42cwom-59_text",
          "type": "text"
        }
      ]
    },
    {
      "id": "sub-mu42cwom-59_text",
      "type": "text",
      "x": -755,
      "y": 3921,
      "width": 329,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42cwoq_4"
      ],
      "roundness": null,
      "seed": 414777,
      "version": 1,
      "versionNonce": 89283,
      "isDeleted": false,
      "text": "Solved GTU Interfacing Questions",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42cwom-59"
    },
    {
      "id": "sub-mu42cwom-50-note",
      "type": "text",
      "x": -1303,
      "y": 3720,
      "width": 314,
      "height": 152,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42cwoq_4"
      ],
      "roundness": null,
      "seed": 677469,
      "version": 1,
      "versionNonce": 476101,
      "isDeleted": false,
      "text": "Input peripherals must connect through\noctal tri-state buffers (IC 74LS244).\nWhen active-low OE' is high, outputs\nremain in High-Impedance (Z), completely\nisolating the peripheral from the data\nbus. During an active I/O read cycle,\naddress decoding and RD' assert OE'=0,\ncleanly routing port data onto D7-D0.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "sub-mu42cwom-59-note",
      "type": "text",
      "x": -1146,
      "y": 3906,
      "width": 314,
      "height": 171,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42cwoq_4"
      ],
      "roundness": null,
      "seed": 612120,
      "version": 1,
      "versionNonce": 319571,
      "isDeleted": false,
      "text": "GTU Winter 2024: Latches provide\nessential temporary-to-static data\nholding for output peripherals,\nresolving data bus transient decay.\nTri-state buffers eliminate electrical\nbus contention during multi-device input\nmultiplexing by enforcing High-Impedance\nisolation until an authorized read\nstrobe occurs.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "sub-mu42cwom-52",
