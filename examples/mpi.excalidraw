      "versionNonce": 958165,
      "isDeleted": false,
      "text": "Input Port Interfacing: Tri-State Buffer (74LS244)",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42zdxy-50"
    },
    {
      "id": "sub-mu42zdxy-59",
      "type": "rectangle",
      "x": -767,
      "y": 3771,
      "width": 353,
      "height": 51,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_4"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 426328,
      "version": 1,
      "versionNonce": 269335,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "sub-mu42zdxy-59_text",
          "type": "text"
        },
        {
          "id": "edge-topic-mu42zdxy-47-sub-mu42zdxy-59",
          "type": "arrow"
