      "version": 1,
      "versionNonce": 865420,
      "isDeleted": false,
      "text": "Random Access Memory (RAM Technologies)",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42zdxy-21"
    },
