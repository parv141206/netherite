        }
      ]
    },
    {
      "id": "flow-mu42cwom-68_text",
      "type": "text",
      "x": 50,
      "y": 5309,
      "width": 356,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
