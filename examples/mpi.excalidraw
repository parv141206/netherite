    },
    {
      "id": "sub-mu42cwom-34_text",
      "type": "text",
      "x": -193,
      "y": 2488,
      "width": 386,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
