      "version": 1,
      "versionNonce": 971234,
      "isDeleted": false,
      "text": "Fundamental Addressability Formulation",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42zdxy-34"
    },
    {
      "id": "sub-mu42zdxy-34-note",
      "type": "text",
      "x": -168,
      "y": 2117,
      "width": 306,
      "height": 171,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_3"
      ],
      "roundness": null,
      "seed": 136665,
      "version": 1,
      "versionNonce": 361791,
      "isDeleted": false,
      "text": "The relationship between address lines\n(N) and uniquely addressable memory\nlocations (M) is strictly M = 2^N. With\nbyte-wide storage (8 bits/location),\ntotal capacity equals 2^N bytes. 10\nlines address 1 KB (1024 B), 12 lines\naddress 4 KB (4096 B), 16 lines address\n64 KB (full 8085 space), and 20 lines\naddress 1 MB (full 8086 space).",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-sub-mu42zdxy-34-sub-mu42zdxy-34-note",
          "type": "arrow"
        }
      ]
    },
    {
