      "height": 51,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_2"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 857357,
      "version": 1,
      "versionNonce": 778912,
      "isDeleted": false,
      "boundElements": [
