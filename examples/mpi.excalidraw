        },
        {
          "id": "edge-flow-mu42zdxy-25-diagram-mu42zdxy-27",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "flow-mu42zdxy-25_text",
      "type": "text",
      "x": 50,
      "y": 1551,
      "width": 281,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_2"
      ],
      "roundness": null,
      "seed": 714839,
      "version": 1,
      "versionNonce": 328580,
      "isDeleted": false,
      "text": "Dynamic RAM (DRAM 1-T 1-C Cell)",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "flow-mu42zdxy-25"
    },
    {
      "id": "sub-mu42zdxy-21-note",
      "type": "text",
      "x": -709,
      "y": 1536,
      "width": 275,
      "height": 95,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_2"
      ],
      "roundness": null,
      "seed": 232511,
      "version": 1,
      "versionNonce": 229990,
      "isDeleted": false,
      "text": "RAM permits both read and write\naccess with identical access\nlatency across all locations. It is\nvolatile, losing data when power is\nremoved.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-sub-mu42zdxy-21-sub-mu42zdxy-21-note",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "flow-mu42zdxy-23-note",
      "type": "text",
      "x": -371,
      "y": 1628,
      "width": 298,
      "height": 133,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_2"
      ],
      "roundness": null,
      "seed": 65247,
      "version": 1,
      "versionNonce": 879768,
      "isDeleted": false,
      "text": "SRAM stores each bit in a bistable\nmulti-transistor flip-flop (6 MOS\ntransistors per cell). It requires no\nrefresh cycles and offers ultra-fast\naccess (10-30 ns), making it ideal for\nCPU caches (L1/L2/L3) and scratchpads\ndespite higher cost and lower density.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-flow-mu42zdxy-23-flow-mu42zdxy-23-note",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "flow-mu42zdxy-25-note",
      "type": "text",
      "x": 49,
      "y": 1628,
      "width": 314,
      "height": 133,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_2"
      ],
      "roundness": null,
      "seed": 583027,
      "version": 1,
      "versionNonce": 245644,
      "isDeleted": false,
      "text": "DRAM stores each bit as charge on a tiny\nMOS gate capacitance (1 transistor + 1\ncapacitor). Dielectric leakage requires\nperiodic refresh cycles every 2-4 ms. It\ndelivers massive density and low cost\nfor main system RAM (DDR4/DDR5) with\n50-100 ns access latency.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-flow-mu42zdxy-25-flow-mu42zdxy-25-note",
          "type": "arrow"
        }
      ]
    },
    {
