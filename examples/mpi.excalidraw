      "width": 439,
      "height": 51,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_2"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 674647,
      "version": 1,
      "versionNonce": 278353,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "sub-mu42zdxy-30_text",
          "type": "text"
        },
        {
          "id": "edge-topic-mu42zdxy-18-sub-mu42zdxy-30",
