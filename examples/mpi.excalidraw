    },
    {
      "id": "flow-mu42cwom-44",
      "type": "rectangle",
      "x": 40,
      "y": 2994,
      "width": 460,
      "height": 49,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu42cwoq_3"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 42169,
      "version": 1,
      "versionNonce": 62863,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "flow-mu42cwom-44_text",
          "type": "text"
        }
      ]
    },
    {
      "id": "flow-mu42cwom-44_text",
      "type": "text",
      "x": 50,
      "y": 3009,
      "width": 440,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42cwoq_3"
      ],
      "roundness": null,
      "seed": 971058,
      "version": 1,
      "versionNonce": 420946,
      "isDeleted": false,
      "text": "Higher Address Line Decoding (A13-A12 via 74LS138)",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "flow-mu42cwom-44"
    },
    {
      "id": "sub-mu42cwom-40-note",
      "type": "text",
      "x": -793,
      "y": 2994,
      "width": 275,
      "height": 152,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42cwoq_3"
      ],
      "roundness": null,
      "seed": 541112,
      "version": 1,
      "versionNonce": 573055,
      "isDeleted": false,
      "text": "A 16 KB microcomputer system built\nfrom 4 KB x 8 chips requires:\nNumber of chips = (16 KB x 8) / (4\nKB x 8) = 4 chips. Address lines\nper individual chip = 2^12 = 12\nlines (A11-A0). Address lines for\ntotal 16 KB space = 2^14 = 14 lines\n(A13-A0).",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "flow-mu42cwom-42-note",
      "type": "text",
      "x": -421,
      "y": 3086,
      "width": 314,
      "height": 95,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42cwoq_3"
      ],
      "roundness": null,
      "seed": 853658,
      "version": 1,
      "versionNonce": 818083,
      "isDeleted": false,
      "text": "Address lines A11 through A0 connect in\nparallel to all 4 memory chips to\nprovide internal 12-bit word indexing\nacross 4096 memory registers within each\nchip.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "flow-mu42cwom-44-note",
      "type": "text",
      "x": 140,
      "y": 3086,
      "width": 291,
      "height": 95,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42cwoq_3"
      ],
      "roundness": null,
      "seed": 810114,
      "version": 1,
      "versionNonce": 955783,
      "isDeleted": false,
      "text": "Higher address lines A13 and A12 feed\ndirectly into a 2-to-4 line decoder\n(74LS138) to generate 4 distinct,\nmutually exclusive active-low Chip\nEnable (CE') strobe signals.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "diagram-mu42cwom-46",
      "type": "rectangle",
      "x": 600,
      "y": 2974,
      "width": 836,
      "height": 235,
      "angle": 0,
      "strokeColor": "#dee2e6",
      "backgroundColor": "#fafafa",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42cwoq_3"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 18529,
      "version": 1,
      "versionNonce": 533518,
      "isDeleted": false
    },
    {
      "id": "diagram-mu42cwom-46_code",
      "type": "text",
      "x": 612,
      "y": 2986,
      "width": 812,
      "height": 211,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42cwoq_3"
      ],
      "roundness": null,
      "seed": 968319,
      "version": 1,
      "versionNonce": 157660,
      "isDeleted": false,
      "text": "+---------------+-------------------+----------------------+------------------------------------------+\n| ADDRESS LINES | CAPACITY FORMULA  | TOTAL BYTES          | INDUSTRY UNIT NOTATION                   |\n+---------------+-------------------+----------------------+------------------------------------------+\n| N = 10 lines  | 2^10 bytes        | 1,024 bytes          | 1 Kilobyte (1 KB)                        |\n| N = 11 lines  | 2^11 = 2 x 2^10   | 2,048 bytes          | 2 Kilobytes (2 KB)                       |\n| N = 12 lines  | 2^12 = 4 x 2^10   | 4,096 bytes          | 4 Kilobytes (4 KB)                       |\n| N = 13 lines  | 2^13 = 8 x 2^10   | 8,192 bytes          | 8 Kilobytes (8 KB)                       |\n| N = 14 lines  | 2^14 = 16 x 2^10  | 16,384 bytes         | 16 Kilobytes (16 KB)                     |\n| N = 15 lines  | 2^15 = 32 x 2^10  | 32,768 bytes         | 32 Kilobytes (32 KB)                     |\n| N = 16 lines  | 2^16 = 64 x 2^10  | 65,536 bytes         | 64 Kilobytes (64 KB) -> Full 8085 Space  |\n| N = 20 lines  | 2^20 = 1 x 2^20   | 1,048,576 bytes      | 1 Megabyte (1 MB) -> Full 8086 Space     |\n+---------------+-------------------+----------------------+------------------------------------------+",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "topic-mu42cwom-47",
