    {
      "id": "sub-mu42zdxy-30_text",
      "type": "text",
      "x": -829,
      "y": 1270,
      "width": 415,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
