      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_4"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 705057,
      "version": 1,
