          "type": "arrow"
        }
      ]
    },
    {
      "id": "flow-mu42zdxy-56_text",
      "type": "text",
      "x": 50,
      "y": 4067,
      "width": 272,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_4"
      ],
      "roundness": null,
      "seed": 618002,
      "version": 1,
      "versionNonce": 60415,
      "isDeleted": false,
      "text": "Latched Persistent Data Output",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "flow-mu42zdxy-56"
    },
    {
      "id": "sub-mu42zdxy-52-note",
      "type": "text",
      "x": -676,
      "y": 4052,
      "width": 275,
      "height": 171,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_4"
      ],
      "roundness": null,
      "seed": 251334,
      "version": 1,
      "versionNonce": 861904,
      "isDeleted": false,
      "text": "Output peripherals require\ntransparent D-latches (IC 74LS373).\nBecause CPU bus data persists for\nonly ~300 ns, the latch captures\ndata on the falling edge of WR'\ncombined with device selection,\nholding output voltage levels\nindefinitely to drive external\ndisplays and actuators.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-sub-mu42zdxy-52-sub-mu42zdxy-52-note",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "flow-mu42zdxy-54-note",
      "type": "text",
      "x": -362,
      "y": 4144,
      "width": 314,
      "height": 114,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_4"
      ],
      "roundness": null,
      "seed": 213538,
      "version": 1,
      "versionNonce": 529727,
      "isDeleted": false,
      "text": "During an I/O Read cycle, address\ndecoder output gates with RD' to pulse\nthe tri-state buffer OE' low, bridging\nperipheral lines to the CPU data bus for\nthe precise duration of the T3 sampling\nphase.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-flow-mu42zdxy-54-flow-mu42zdxy-54-note",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "flow-mu42zdxy-56-note",
      "type": "text",
      "x": 52,
      "y": 4144,
      "width": 298,
      "height": 95,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_4"
      ],
      "roundness": null,
      "seed": 54261,
      "version": 1,
      "versionNonce": 362879,
      "isDeleted": false,
      "text": "During an I/O Write cycle, the address\ndecoder gates with WR' to pulse the\nlatch clock pin, capturing transient\ndata from D7-D0 and sustaining static\noutput drive indefinitely.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-flow-mu42zdxy-56-flow-mu42zdxy-56-note",
          "type": "arrow"
        }
      ]
    },
    {
