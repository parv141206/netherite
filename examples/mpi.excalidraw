      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu42zdy2_1"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 518510,
