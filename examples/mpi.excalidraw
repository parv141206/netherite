        "grp_mu42cwoq_3"
      ],
      "roundness": null,
      "seed": 521693,
      "version": 1,
      "versionNonce": 123727,
      "isDeleted": false,
      "text": "Fundamental Addressability Formulation",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42cwom-34"
    },
    {
      "id": "sub-mu42cwom-34-note",
      "type": "text",
      "x": -168,
      "y": 2252,
      "width": 306,
      "height": 171,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42cwoq_3"
      ],
      "roundness": null,
      "seed": 50541,
      "version": 1,
      "versionNonce": 750858,
      "isDeleted": false,
      "text": "The relationship between address lines\n(N) and uniquely addressable memory\nlocations (M) is strictly M = 2^N. With\nbyte-wide storage (8 bits/location),\ntotal capacity equals 2^N bytes. 10\nlines address 1 KB (1024 B), 12 lines\naddress 4 KB (4096 B), 16 lines address\n64 KB (full 8085 space), and 20 lines\naddress 1 MB (full 8086 space).",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "sub-mu42cwom-36",
      "type": "rectangle",
      "x": -787,
      "y": 2542,
      "width": 410,
      "height": 51,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu42cwoq_3"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 170635,
      "version": 1,
      "versionNonce": 952954,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "sub-mu42cwom-36_text",
          "type": "text"
        }
      ]
    },
