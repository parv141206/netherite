        "grp_mu42cwoq_1"
      ],
      "roundness": null,
      "seed": 602664,
      "version": 1,
      "versionNonce": 574412,
      "isDeleted": false,
      "text": "Internal vs External System Operations",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42cwol-4"
    },
    {
      "id": "sub-mu42cwol-4-note",
      "type": "text",
      "x": -172,
      "y": -450,
      "width": 314,
      "height": 190,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42cwoq_1"
      ],
      "roundness": null,
      "seed": 830359,
      "version": 1,
      "versionNonce": 776568,
      "isDeleted": false,
      "text": "A microprocessor is an active digital\nlogic device executing programs stored\nin memory. Its operations divide into\ntwo domains: Internal Operations\nexecuted within the CPU architecture\n(ALU operations, register transfers,\nflag updates, instruction decoding), and\nExternal Bus Operations communicating\nacross system buses with memory chips\nand I/O peripherals.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "sub-mu42cwol-13",
      "type": "rectangle",
