      "containerId": "flow-mu42ugjx-17"
    },
    {
      "id": "flow-mu42ugjx-17-note-0",
      "type": "text",
      "x": 784,
      "y": -274,
      "width": 314,
      "height": 95,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ugk0_1"
      ],
      "roundness": null,
      "seed": 950118,
      "version": 1,
      "versionNonce": 435393,
      "isDeleted": false,
      "text": "Ping sends ICMP Echo Requests (Type 8)\nexpecting Echo Replies (Type 0) to\nverify bidirectional end-to-end\nreachability and measure Round-Trip Time\n(RTT).",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-flow-mu42ugjx-17-flow-mu42ugjx-17-note-0",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "flow-mu42ugjx-17-note-1",
      "type": "text",
      "x": 784,
      "y": -144,
      "width": 314,
      "height": 95,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ugk0_1"
      ],
      "roundness": null,
      "seed": 343933,
      "version": 1,
      "versionNonce": 991778,
      "isDeleted": false,
      "text": "Traceroute transmits packets with\nincrementing TTL values (1, 2, 3...) to\ntrigger ICMP Time Exceeded (Type 11)\nmessages, mapping each transit router in\nthe forwarding path.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-flow-mu42ugjx-17-flow-mu42ugjx-17-note-1",
          "type": "arrow"
        }
      ]
    },
