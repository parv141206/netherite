        }
      ]
    },
    {
      "id": "sub-mu42ugjx-28_text",
      "type": "text",
      "x": -141,
      "y": 1012,
      "width": 282,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ugk0_2"
      ],
      "roundness": null,
      "seed": 802155,
      "version": 1,
      "versionNonce": 571203,
      "isDeleted": false,
      "text": "Reliable Transmission & ARQ",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42ugjx-28"
    },
    {
      "id": "sub-mu42ugjx-28-note",
      "type": "text",
      "x": -168,
      "y": 757,
      "width": 306,
      "height": 190,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ugk0_2"
      ],
      "roundness": null,
      "seed": 353463,
      "version": 1,
      "versionNonce": 300847,
      "isDeleted": false,
      "text": "TCP treats payload data as an\nunstructured stream of bytes. Sequence\nnumbers track the first byte in each\nsegment. The receiver issues cumulative\nACKs indicating the next expected byte.\nIf 3 duplicate ACKs arrive, Fast\nRetransmit immediately resends the\nmissing segment without waiting for the\nRetransmission Timeout (RTO) timer to\nexpire.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-sub-mu42ugjx-28-sub-mu42ugjx-28-note",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "sub-mu42ugjx-32",
      "type": "rectangle",
      "x": 380,
      "y": 1187,
      "width": 334,
      "height": 51,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ugk0_2"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 145656,
      "version": 1,
      "versionNonce": 575938,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "sub-mu42ugjx-32_text",
          "type": "text"
        },
        {
          "id": "edge-topic-mu42ugjx-20-sub-mu42ugjx-32",
          "type": "arrow"
        },
