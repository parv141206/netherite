      "version": 1,
      "versionNonce": 161460,
      "isDeleted": false,
      "text": "Connection Lifecycle & State Machine",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu426zol-21"
    },
    {
      "id": "flow-mu426zol-23",
