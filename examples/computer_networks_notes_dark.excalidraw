        },
        {
          "id": "edge-sub-mu42ugjx-32-flow-mu42ugjx-34",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "sub-mu42ugjx-32_text",
      "type": "text",
      "x": 392,
      "y": 1202,
      "width": 310,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ugk0_2"
      ],
      "roundness": null,
      "seed": 946960,
      "version": 1,
      "versionNonce": 371108,
      "isDeleted": false,
      "text": "Congestion Control & Avoidance",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42ugjx-32"
    },
    {
      "id": "sub-mu42ugjx-32-note",
      "type": "text",
      "x": 405,
      "y": 1278,
      "width": 298,
      "height": 76,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ugk0_2"
      ],
      "roundness": null,
      "seed": 799381,
      "version": 1,
      "versionNonce": 958322,
      "isDeleted": false,
      "text": "TCP regulates network load via\nCongestion Window (cwnd) maintained by\nthe sender. Transmission rate is\nthrottled to min(cwnd, rwnd).",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-sub-mu42ugjx-32-sub-mu42ugjx-32-note",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "flow-mu42ugjx-34",
      "type": "rectangle",
      "x": 400,
      "y": 1053,
      "width": 225,
      "height": 49,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ugk0_2"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 495392,
      "version": 1,
      "versionNonce": 934205,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "flow-mu42ugjx-34_text",
          "type": "text"
        },
        {
          "id": "edge-sub-mu42ugjx-32-flow-mu42ugjx-34",
          "type": "arrow"
        },
        {
          "id": "edge-flow-mu42ugjx-34-flow-mu42ugjx-34-note-0",
