      "backgroundColor": "#1a1a1f",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_1"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 766013,
