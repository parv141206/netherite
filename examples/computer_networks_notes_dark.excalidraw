      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ugk0_3"
      ],
      "roundness": null,
      "seed": 8165,
      "version": 1,
      "versionNonce": 106374,
      "isDeleted": false,
      "text": "Core Protocols & Production Use Cases",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42ugjx-45"
    },
    {
      "id": "sub-mu42ugjx-43-note",
      "type": "text",
      "x": -1039,
      "y": 2299,
      "width": 314,
      "height": 171,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ugk0_3"
      ],
      "roundness": null,
      "seed": 498925,
      "version": 1,
      "versionNonce": 520383,
      "isDeleted": false,
      "text": "UDP computes an optional 16-bit one's\ncomplement checksum over a pseudo-header\n(Source IP, Destination IP, Protocol 17,\nUDP Length) combined with the header and\npayload. Corrupted datagrams are\ndiscarded silently without generating\nACKs or error packets, delegating any\nrecovery logic to user-space application\nprotocols.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-sub-mu42ugjx-43-sub-mu42ugjx-43-note",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "sub-mu42ugjx-45-note",
      "type": "text",
      "x": -1086,
      "y": 2515,
      "width": 306,
      "height": 152,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ugk0_3"
      ],
      "roundness": null,
      "seed": 536109,
      "version": 1,
      "versionNonce": 493422,
      "isDeleted": false,
      "text": "UDP powers real-time and foundational\nnetwork infrastructure: DNS queries for\ninstant domain resolution, DHCP for\nbootstrap host configuration, NTP for\ndistributed clock synchronization, and\nWebRTC / RTP for real-time video\nconferencing where low latency\nsupersedes packet retransmission.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-sub-mu42ugjx-45-sub-mu42ugjx-45-note",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "sub-mu42ugjx-40",
