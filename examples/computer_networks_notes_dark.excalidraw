    },
    {
      "id": "sub-mu426zol-13",
      "type": "rectangle",
      "x": -764,
      "y": 30,
      "width": 486,
      "height": 51,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "#212529",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_1"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 374784,
      "version": 1,
      "versionNonce": 280008,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "sub-mu426zol-13_text",
          "type": "text"
        }
      ]
    },
    {
      "id": "sub-mu426zol-13_text",
      "type": "text",
      "x": -752,
      "y": 45,
      "width": 462,
      "height": 22,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_1"
      ],
      "roundness": null,
      "seed": 460798,
      "version": 1,
      "versionNonce": 295584,
      "isDeleted": false,
      "text": "Subnetting & Network Address Translation (NAT)",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu426zol-13"
    },
    {
      "id": "sub-mu426zol-4-note",
      "type": "text",
      "x": -1027,
      "y": -216,
      "width": 314,
      "height": 208,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_1"
      ],
      "roundness": null,
      "seed": 127614,
      "version": 1,
      "versionNonce": 228432,
      "isDeleted": false,
      "text": "The standard IPv4 header is 20 bytes\nlong without optional fields (up to 60\nbytes with options). The 4-bit IHL field\nspecifies header length in 32-bit words.\nTotal Length supports datagrams up to\n65,535 bytes. The Time-to-Live (TTL)\nfield decrements at each forwarding\nrouter hop to prevent forwarding loops.\nProtocol field multiplexes Layer 4\npayloads (6 for TCP, 17 for UDP, 1 for\nICMP).",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "sub-mu426zol-13-note",
      "type": "text",
      "x": -1143,
      "y": 30,
      "width": 314,
      "height": 208,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_1"
      ],
      "roundness": null,
      "seed": 451911,
      "version": 1,
      "versionNonce": 673683,
      "isDeleted": false,
      "text": "Subnetting divides address blocks into\nsmaller collision and broadcast domains.\nNAT rewrites IP headers at the router\nboundary, allowing multiple internal\nhosts with private RFC 1918 IPs to share\na single public IP. Port Address\nTranslation (PAT / NAPT) tracks sessions\nvia 16-bit ephemeral source ports,\nmultiplexing thousands of concurrent\nexternal connections across one public\nIP address.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "sub-mu426zol-6",
      "type": "rectangle",
      "x": -148,
      "y": 190,
      "width": 296,
      "height": 51,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "#212529",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_1"
      ],
