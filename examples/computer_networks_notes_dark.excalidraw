      "version": 1,
      "versionNonce": 89830,
      "isDeleted": false,
      "text": "Internet Protocol v4 (IPv4)",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "topic-mu426zol-1"
    },
    {
      "id": "sub-mu426zol-2",
      "type": "rectangle",
      "x": -105,
      "y": -210,
      "width": 210,
      "height": 51,
      "angle": 0,
