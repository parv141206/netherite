        "grp_mu426zop_2"
      ],
      "roundness": null,
      "seed": 750989,
      "version": 1,
      "versionNonce": 340333,
      "isDeleted": false,
      "text": "Three-Way Handshake",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "flow-mu426zol-23"
    },
    {
      "id": "flow-mu426zol-25",
      "type": "rectangle",
      "x": 40,
      "y": 1518,
      "width": 309,
      "height": 49,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "#1a1a1f",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_2"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 977618,
      "version": 1,
      "versionNonce": 734540,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "flow-mu426zol-25_text",
          "type": "text"
        }
      ]
    },
    {
      "id": "flow-mu426zol-25_text",
      "type": "text",
      "x": 50,
      "y": 1533,
      "width": 289,
      "height": 20,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_2"
      ],
      "roundness": null,
      "seed": 533317,
      "version": 1,
      "versionNonce": 864810,
      "isDeleted": false,
      "text": "Four-Way Termination & TIME_WAIT",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "flow-mu426zol-25"
    },
    {
      "id": "sub-mu426zol-21-note",
      "type": "text",
      "x": -605,
      "y": 1518,
      "width": 275,
      "height": 171,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_2"
      ],
      "roundness": null,
      "seed": 28235,
      "version": 1,
      "versionNonce": 670221,
      "isDeleted": false,
      "text": "TCP is a connection-oriented,\nfull-duplex protocol providing\nreliable stream transport. Sockets\nsynchronize state using explicit\nhandshakes before exchanging\npayload data, and transition\nthrough established states (LISTEN,\nSYN_SENT, ESTABLISHED, FIN_WAIT,\nTIME_WAIT).",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "flow-mu426zol-23-note",
      "type": "text",
      "x": -447,
      "y": 1730,
      "width": 314,
      "height": 114,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_2"
      ],
      "roundness": null,
      "seed": 575924,
      "version": 1,
      "versionNonce": 888389,
      "isDeleted": false,
      "text": "Client initiates with SYN (Seq=x).\nServer responds with SYN-ACK (Seq=y,\nAck=x+1). Client completes handshake\nwith ACK (Ack=y+1). Both hosts establish\nsequence baseline and initial receive\nwindows.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "flow-mu426zol-25-note",
      "type": "text",
      "x": 57,
      "y": 1610,
      "width": 306,
      "height": 114,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_2"
      ],
      "roundness": null,
      "seed": 303935,
      "version": 1,
      "versionNonce": 683877,
      "isDeleted": false,
      "text": "Active closer sends FIN. Passive\nreceiver ACKs. Once application closes,\nreceiver sends FIN. Final ACK from\ninitiator triggers TIME_WAIT state (2 *\nMSL) ensuring late arriving segments\ndrain before port reuse.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "diagram-mu426zol-27",
      "type": "rectangle",
      "x": 560,
      "y": 1498,
      "width": 539,
      "height": 320,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "#141517",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_2"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 443563,
      "version": 1,
      "versionNonce": 203414,
      "isDeleted": false
    },
    {
      "id": "diagram-mu426zol-27_code",
      "type": "text",
      "x": 572,
      "y": 1510,
