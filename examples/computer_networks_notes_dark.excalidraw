      "seed": 23441,
      "version": 1,
      "versionNonce": 649359,
      "isDeleted": false,
      "text": "User Datagram Protocol (UDP)",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "topic-mu426zol-37"
    },
    {
      "id": "sub-mu426zol-38",
      "type": "rectangle",
      "x": -162,
      "y": 2245,
      "width": 325,
      "height": 51,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "#212529",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_3"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 661186,
      "version": 1,
      "versionNonce": 468060,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "sub-mu426zol-38_text",
          "type": "text"
        }
      ]
    },
    {
      "id": "sub-mu426zol-38_text",
      "type": "text",
      "x": -150,
      "y": 2260,
      "width": 301,
      "height": 22,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_3"
      ],
      "roundness": null,
      "seed": 491243,
      "version": 1,
      "versionNonce": 37452,
      "isDeleted": false,
      "text": "Stateless & Minimal Transport",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu426zol-38"
    },
    {
      "id": "sub-mu426zol-38-note",
      "type": "text",
      "x": -172,
      "y": 2024,
      "width": 314,
      "height": 171,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_3"
      ],
      "roundness": null,
      "seed": 957073,
      "version": 1,
      "versionNonce": 446137,
      "isDeleted": false,
      "text": "UDP provides lightweight, connectionless\ndatagram transport with zero state\nmanagement. Unlike TCP, UDP executes no\nhandshakes, maintains no socket buffer\nstates, provides no retransmissions, and\nenforces no ordering or congestion\nbackoff. Applications gain direct, raw\ntransmission access to IP layer\nperformance.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "sub-mu426zol-47",
      "type": "rectangle",
      "x": 380,
      "y": 2435,
      "width": 229,
      "height": 51,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "#212529",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_3"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 488680,
      "version": 1,
      "versionNonce": 450780,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "sub-mu426zol-47_text",
          "type": "text"
        }
      ]
    },
    {
      "id": "sub-mu426zol-47_text",
      "type": "text",
      "x": 392,
      "y": 2450,
      "width": 205,
      "height": 22,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_3"
      ],
      "roundness": null,
      "seed": 211333,
      "version": 1,
      "versionNonce": 953285,
      "isDeleted": false,
      "text": "Protocol Trade-offs",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu426zol-47"
    },
    {
      "id": "sub-mu426zol-47-note",
      "type": "text",
      "x": 405,
      "y": 2526,
      "width": 306,
      "height": 57,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_3"
      ],
      "roundness": null,
      "seed": 79298,
      "version": 1,
      "versionNonce": 603164,
      "isDeleted": false,
      "text": "Understanding when to select TCP versus\nUDP is fundamental to high-performance\nnetwork system design.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "flow-mu426zol-49",
      "type": "rectangle",
      "x": 400,
      "y": 2301,
      "width": 242,
      "height": 49,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "#1a1a1f",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_3"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 632215,
      "version": 1,
      "versionNonce": 911365,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "flow-mu426zol-49_text",
          "type": "text"
        }
      ]
    },
    {
      "id": "flow-mu426zol-49_text",
      "type": "text",
      "x": 410,
      "y": 2316,
      "width": 222,
      "height": 20,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_3"
      ],
      "roundness": null,
      "seed": 76579,
      "version": 1,
      "versionNonce": 135397,
      "isDeleted": false,
      "text": "Architectural Comparison",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "flow-mu426zol-49"
    },
    {
      "id": "flow-mu426zol-49-note-0",
      "type": "text",
      "x": 746,
      "y": 2200,
      "width": 298,
      "height": 76,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_3"
      ],
      "roundness": null,
      "seed": 249921,
      "version": 1,
      "versionNonce": 789518,
      "isDeleted": false,
      "text": "TCP guarantees reliable, in-order byte\ndelivery with congestion throttling at\nthe cost of 3-way handshake delay and\nhead-of-line blocking stalls.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "flow-mu426zol-49-note-1",
      "type": "text",
      "x": 746,
      "y": 2311,
      "width": 306,
      "height": 76,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_3"
      ],
      "roundness": null,
      "seed": 70533,
      "version": 1,
      "versionNonce": 283166,
      "isDeleted": false,
      "text": "UDP delivers unthrottled zero-latency\ndatagrams with minimal packet overhead,\nserving as the modern foundation for\nHTTP/3 QUIC transport.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "sub-mu426zol-43",
      "type": "rectangle",
      "x": -675,
      "y": 2314,
      "width": 391,
      "height": 51,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "#212529",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_3"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 329690,
      "version": 1,
      "versionNonce": 736642,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "sub-mu426zol-43_text",
          "type": "text"
        }
      ]
    },
    {
      "id": "sub-mu426zol-43_text",
      "type": "text",
      "x": -663,
      "y": 2329,
      "width": 367,
      "height": 22,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_3"
      ],
      "roundness": null,
      "seed": 957432,
      "version": 1,
      "versionNonce": 52236,
      "isDeleted": false,
      "text": "Error Detection & Checksum Mechanism",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu426zol-43"
    },
    {
      "id": "sub-mu426zol-45",
      "type": "rectangle",
      "x": -685,
      "y": 2485,
      "width": 401,
      "height": 51,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "#212529",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_3"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 118319,
      "version": 1,
      "versionNonce": 927285,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "sub-mu426zol-45_text",
          "type": "text"
        }
      ]
    },
    {
      "id": "sub-mu426zol-45_text",
      "type": "text",
      "x": -673,
      "y": 2500,
      "width": 377,
      "height": 22,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_3"
      ],
      "roundness": null,
      "seed": 126051,
      "version": 1,
      "versionNonce": 110113,
      "isDeleted": false,
      "text": "Core Protocols & Production Use Cases",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu426zol-45"
    },
    {
      "id": "sub-mu426zol-43-note",
      "type": "text",
      "x": -1039,
      "y": 2299,
      "width": 314,
      "height": 171,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_3"
      ],
      "roundness": null,
      "seed": 458478,
      "version": 1,
      "versionNonce": 436675,
      "isDeleted": false,
      "text": "UDP computes an optional 16-bit one's\ncomplement checksum over a pseudo-header\n(Source IP, Destination IP, Protocol 17,\nUDP Length) combined with the header and\npayload. Corrupted datagrams are\ndiscarded silently without generating\nACKs or error packets, delegating any\nrecovery logic to user-space application\nprotocols.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "sub-mu426zol-45-note",
      "type": "text",
      "x": -1086,
      "y": 2515,
      "width": 306,
      "height": 152,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_3"
      ],
      "roundness": null,
      "seed": 11308,
      "version": 1,
      "versionNonce": 925099,
      "isDeleted": false,
      "text": "UDP powers real-time and foundational\nnetwork infrastructure: DNS queries for\ninstant domain resolution, DHCP for\nbootstrap host configuration, NTP for\ndistributed clock synchronization, and\nWebRTC / RTP for real-time video\nconferencing where low latency\nsupersedes packet retransmission.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "sub-mu426zol-40",
      "type": "rectangle",
      "x": -176,
      "y": 2645,
      "width": 353,
      "height": 51,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "#212529",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_3"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 654977,
      "version": 1,
      "versionNonce": 31977,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "sub-mu426zol-40_text",
          "type": "text"
        }
      ]
    },
    {
      "id": "sub-mu426zol-40_text",
      "type": "text",
      "x": -164,
      "y": 2660,
      "width": 329,
      "height": 22,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_3"
      ],
      "roundness": null,
      "seed": 907604,
      "version": 1,
      "versionNonce": 662439,
      "isDeleted": false,
      "text": "Fixed 8-Byte Header Architecture",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu426zol-40"
    },
    {
      "id": "sub-mu426zol-40-note",
      "type": "text",
      "x": -172,
      "y": 2746,
      "width": 314,
      "height": 152,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_3"
      ],
      "roundness": null,
      "seed": 92784,
      "version": 1,
      "versionNonce": 427752,
      "isDeleted": false,
      "text": "UDP features an ultra-compact 8-byte\nheader minimizing packet overhead and\nserialization latency. It consists of\nfour 16-bit fields: Source Port,\nDestination Port, Length (header +\npayload, min 8 bytes), and Checksum. The\nsimple structure allows line-rate ASIC\nparsing in network hardware.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "diagram-mu426zol-42",
      "type": "rectangle",
      "x": 560,
      "y": 2625,
      "width": 539,
      "height": 185,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "#141517",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_3"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 898648,
      "version": 1,
      "versionNonce": 988285,
      "isDeleted": false
    },
