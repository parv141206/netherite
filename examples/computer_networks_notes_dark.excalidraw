        {
          "id": "edge-flow-mu42ugjx-34-flow-mu42ugjx-34-note-1",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "flow-mu42ugjx-34_text",
      "type": "text",
      "x": 410,
      "y": 1068,
      "width": 205,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ugk0_2"
      ],
      "roundness": null,
      "seed": 467526,
      "version": 1,
      "versionNonce": 626989,
      "isDeleted": false,
      "text": "AIMD & Rate Adaptation",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "flow-mu42ugjx-34"
    },
    {
      "id": "flow-mu42ugjx-34-note-0",
      "type": "text",
      "x": 774,
      "y": 952,
      "width": 291,
      "height": 76,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ugk0_2"
      ],
      "roundness": null,
      "seed": 347589,
      "version": 1,
      "versionNonce": 350921,
      "isDeleted": false,
      "text": "Slow Start exponentially doubles cwnd\nevery RTT until reaching slow start\nthreshold (ssthresh), rapidly\ndiscovering bottleneck bandwidth.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-flow-mu42ugjx-34-flow-mu42ugjx-34-note-0",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "flow-mu42ugjx-34-note-1",
      "type": "text",
      "x": 774,
      "y": 1063,
      "width": 283,
      "height": 95,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ugk0_2"
      ],
      "roundness": null,
      "seed": 760746,
      "version": 1,
      "versionNonce": 877590,
      "isDeleted": false,
      "text": "Congestion Avoidance increments cwnd\nlinearly by 1 MSS per RTT once past\nssthresh, using Additive Increase\nMultiplicative Decrease (AIMD) to\nstabilize throughput.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-flow-mu42ugjx-34-flow-mu42ugjx-34-note-1",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "sub-mu42ugjx-30",
      "type": "rectangle",
      "x": -605,
      "y": 1182,
      "width": 277,
      "height": 51,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ugk0_2"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 654752,
      "version": 1,
      "versionNonce": 655738,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "sub-mu42ugjx-30_text",
          "type": "text"
        },
        {
          "id": "edge-topic-mu42ugjx-20-sub-mu42ugjx-30",
          "type": "arrow"
        },
        {
          "id": "edge-sub-mu42ugjx-30-sub-mu42ugjx-30-note",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "sub-mu42ugjx-30_text",
      "type": "text",
      "x": -593,
      "y": 1196,
      "width": 253,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ugk0_2"
      ],
      "roundness": null,
      "seed": 654957,
      "version": 1,
      "versionNonce": 67859,
      "isDeleted": false,
      "text": "Flow Control & Windowing",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42ugjx-30"
    },
    {
      "id": "sub-mu42ugjx-30-note",
      "type": "text",
      "x": -969,
      "y": 1172,
      "width": 314,
      "height": 190,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ugk0_2"
      ],
      "roundness": null,
      "seed": 798453,
      "version": 1,
      "versionNonce": 36463,
      "isDeleted": false,
      "text": "Flow control prevents a fast sender from\noverwhelming a slow receiver. The\nreceiver advertises its available buffer\ncapacity in the 16-bit Window Size field\n(rwnd). When rwnd drops to 0, sender\nstops transmitting and periodically\nemits Zero-Window Probes to detect when\nreceiver buffer space clears. Window\nScaling option (RFC 7323) shifts window\nsize up to 1 GB.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
