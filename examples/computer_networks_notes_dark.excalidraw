      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ugk0_2"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 110083,
      "version": 1,
      "versionNonce": 413791,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "sub-mu42ugjx-28_text",
          "type": "text"
        },
        {
          "id": "edge-topic-mu42ugjx-20-sub-mu42ugjx-28",
          "type": "arrow"
        },
        {
          "id": "edge-sub-mu42ugjx-28-sub-mu42ugjx-28-note",
