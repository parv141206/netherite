        "grp_mu426zop_1"
      ],
      "roundness": null,
      "seed": 405567,
      "version": 1,
      "versionNonce": 587356,
      "isDeleted": false,
      "text": "Diagnostics & Control Protocols",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu426zol-15"
    },
    {
      "id": "sub-mu426zol-15-note",
      "type": "text",
      "x": 405,
      "y": 71,
      "width": 314,
      "height": 76,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_1"
      ],
      "roundness": null,
      "seed": 721493,
      "version": 1,
      "versionNonce": 730683,
      "isDeleted": false,
      "text": "Internet Control Message Protocol (ICMP)\noperates alongside IPv4 to communicate\nnetwork layer errors and diagnostic\nmetrics back to source hosts.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "flow-mu426zol-17",
      "type": "rectangle",
      "x": 400,
      "y": -154,
      "width": 259,
      "height": 49,
      "angle": 0,
