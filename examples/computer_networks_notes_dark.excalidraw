      ],
      "roundness": null,
      "seed": 96033,
      "version": 1,
      "versionNonce": 989435,
      "isDeleted": false,
      "text": "Subnetting & Network Address Translation (NAT)",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42ugjw-13"
    },
    {
      "id": "sub-mu42ugjw-4-note",
      "type": "text",
      "x": -1027,
      "y": -216,
      "width": 314,
      "height": 208,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ugk0_1"
      ],
      "roundness": null,
      "seed": 230257,
      "version": 1,
      "versionNonce": 333276,
      "isDeleted": false,
      "text": "The standard IPv4 header is 20 bytes\nlong without optional fields (up to 60\nbytes with options). The 4-bit IHL field\nspecifies header length in 32-bit words.\nTotal Length supports datagrams up to\n65,535 bytes. The Time-to-Live (TTL)\nfield decrements at each forwarding\nrouter hop to prevent forwarding loops.\nProtocol field multiplexes Layer 4\npayloads (6 for TCP, 17 for UDP, 1 for\nICMP).",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-sub-mu42ugjw-4-sub-mu42ugjw-4-note",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "sub-mu42ugjw-13-note",
      "type": "text",
      "x": -1143,
      "y": 30,
      "width": 314,
      "height": 208,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ugk0_1"
      ],
      "roundness": null,
      "seed": 47898,
      "version": 1,
      "versionNonce": 73466,
      "isDeleted": false,
      "text": "Subnetting divides address blocks into\nsmaller collision and broadcast domains.\nNAT rewrites IP headers at the router\nboundary, allowing multiple internal\nhosts with private RFC 1918 IPs to share\na single public IP. Port Address\nTranslation (PAT / NAPT) tracks sessions\nvia 16-bit ephemeral source ports,\nmultiplexing thousands of concurrent\nexternal connections across one public\nIP address.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-sub-mu42ugjw-13-sub-mu42ugjw-13-note",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "sub-mu42ugjw-6",
