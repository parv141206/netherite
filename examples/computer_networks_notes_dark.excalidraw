      "seed": 325254,
      "version": 1,
      "versionNonce": 529293,
      "isDeleted": false,
      "text": "Fragmentation & Reassembly",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu426zol-6"
    },
    {
      "id": "flow-mu426zol-8",
