      "versionNonce": 898499,
      "isDeleted": false,
      "text": "Transmission Control Protocol (TCP)",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "topic-mu42ugjx-20"
    },
    {
      "id": "sub-mu42ugjx-28",
      "type": "rectangle",
      "x": -153,
      "y": 997,
      "width": 306,
      "height": 51,
