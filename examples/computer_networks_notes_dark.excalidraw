      ],
      "roundness": null,
      "seed": 854265,
      "version": 1,
      "versionNonce": 288539,
      "isDeleted": false,
      "text": "ICMP Diagnostic Operations",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "flow-mu426zol-17"
    },
    {
      "id": "flow-mu426zol-17-note-0",
      "type": "text",
      "x": 784,
      "y": -274,
      "width": 314,
      "height": 95,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_1"
      ],
      "roundness": null,
      "seed": 938250,
      "version": 1,
      "versionNonce": 49035,
      "isDeleted": false,
      "text": "Ping sends ICMP Echo Requests (Type 8)\nexpecting Echo Replies (Type 0) to\nverify bidirectional end-to-end\nreachability and measure Round-Trip Time\n(RTT).",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "flow-mu426zol-17-note-1",
      "type": "text",
      "x": 784,
      "y": -144,
      "width": 314,
      "height": 95,
      "angle": 0,
      "strokeColor": "#f8f9fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu426zop_1"
      ],
      "roundness": null,
      "seed": 185620,
      "version": 1,
      "versionNonce": 70370,
      "isDeleted": false,
      "text": "Traceroute transmits packets with\nincrementing TTL values (1, 2, 3...) to\ntrigger ICMP Time Exceeded (Type 11)\nmessages, mapping each transit router in\nthe forwarding path.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "sub-mu426zol-4",
