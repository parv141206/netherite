    {
      "id": "flow-mu423oaj-25",
      "type": "rectangle",
      "x": 40,
      "y": 1518,
      "width": 309,
      "height": 49,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu423oan_2"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 994298,
      "version": 1,
      "versionNonce": 764146,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "flow-mu423oaj-25_text",
