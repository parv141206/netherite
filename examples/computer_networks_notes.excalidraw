      "seed": 491301,
      "version": 1,
      "versionNonce": 548542,
      "isDeleted": false,
      "text": "Stateless & Minimal Transport",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42ze1z-38"
    },
    {
      "id": "sub-mu42ze1z-38-note",
      "type": "text",
      "x": -172,
      "y": 2024,
      "width": 314,
      "height": 171,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ze23_3"
      ],
      "roundness": null,
      "seed": 995971,
      "version": 1,
      "versionNonce": 427072,
      "isDeleted": false,
      "text": "UDP provides lightweight, connectionless\ndatagram transport with zero state\nmanagement. Unlike TCP, UDP executes no\nhandshakes, maintains no socket buffer\nstates, provides no retransmissions, and\nenforces no ordering or congestion\nbackoff. Applications gain direct, raw\ntransmission access to IP layer\nperformance.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-sub-mu42ze1z-38-sub-mu42ze1z-38-note",
          "type": "arrow"
        }
      ]
    },
    {
