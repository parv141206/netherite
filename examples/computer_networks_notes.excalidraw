      "seed": 230030,
      "version": 1,
      "versionNonce": 447953,
      "isDeleted": false,
      "text": "Architectural Comparison",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "flow-mu42ze20-49"
    },
    {
      "id": "flow-mu42ze20-49-note-0",
      "type": "text",
      "x": 746,
      "y": 2205,
      "width": 298,
      "height": 76,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ze23_3"
      ],
      "roundness": null,
      "seed": 884332,
      "version": 1,
      "versionNonce": 761951,
      "isDeleted": false,
      "text": "TCP guarantees reliable, in-order byte\ndelivery with congestion throttling at\nthe cost of 3-way handshake delay and\nhead-of-line blocking stalls.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-flow-mu42ze20-49-flow-mu42ze20-49-note-0",
          "type": "arrow"
