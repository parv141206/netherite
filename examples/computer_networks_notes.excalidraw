      ],
      "roundness": null,
      "seed": 92175,
      "version": 1,
      "versionNonce": 300365,
      "isDeleted": false,
      "text": "Subnetting & Network Address Translation (NAT)",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42ze1z-13"
    },
    {
      "id": "sub-mu42ze1z-4-note",
      "type": "text",
      "x": -1027,
      "y": -216,
      "width": 314,
      "height": 208,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ze23_1"
      ],
      "roundness": null,
      "seed": 860316,
      "version": 1,
      "versionNonce": 334252,
      "isDeleted": false,
      "text": "The standard IPv4 header is 20 bytes\nlong without optional fields (up to 60\nbytes with options). The 4-bit IHL field\nspecifies header length in 32-bit words.\nTotal Length supports datagrams up to\n65,535 bytes. The Time-to-Live (TTL)\nfield decrements at each forwarding\nrouter hop to prevent forwarding loops.\nProtocol field multiplexes Layer 4\npayloads (6 for TCP, 17 for UDP, 1 for\nICMP).",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-sub-mu42ze1z-4-sub-mu42ze1z-4-note",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "sub-mu42ze1z-13-note",
      "type": "text",
      "x": -1143,
      "y": 30,
      "width": 314,
      "height": 208,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ze23_1"
      ],
      "roundness": null,
      "seed": 511348,
      "version": 1,
      "versionNonce": 863938,
      "isDeleted": false,
      "text": "Subnetting divides address blocks into\nsmaller collision and broadcast domains.\nNAT rewrites IP headers at the router\nboundary, allowing multiple internal\nhosts with private RFC 1918 IPs to share\na single public IP. Port Address\nTranslation (PAT / NAPT) tracks sessions\nvia 16-bit ephemeral source ports,\nmultiplexing thousands of concurrent\nexternal connections across one public\nIP address.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-sub-mu42ze1z-13-sub-mu42ze1z-13-note",
          "type": "arrow"
        }
      ]
    },
    {
