    {
      "id": "flow-mu42ze20-49-note-1",
      "type": "text",
      "x": 746,
      "y": 2370,
      "width": 306,
      "height": 76,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ze23_3"
      ],
      "roundness": null,
      "seed": 204470,
      "version": 1,
      "versionNonce": 560248,
      "isDeleted": false,
      "text": "UDP delivers unthrottled zero-latency\ndatagrams with minimal packet overhead,\nserving as the modern foundation for\nHTTP/3 QUIC transport.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-flow-mu42ze20-49-flow-mu42ze20-49-note-1",
          "type": "arrow"
        }
      ]
    },
