      "opacity": 100,
      "groupIds": [
        "grp_mu423oan_1"
      ],
      "roundness": null,
      "seed": 136486,
      "version": 1,
      "versionNonce": 118253,
      "isDeleted": false,
      "text": "ICMP Diagnostic Operations",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "flow-mu423oaj-17"
    },
    {
      "id": "flow-mu423oaj-17-note-0",
      "type": "text",
      "x": 784,
      "y": -274,
      "width": 314,
      "height": 95,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu423oan_1"
      ],
      "roundness": null,
      "seed": 775440,
      "version": 1,
      "versionNonce": 293274,
      "isDeleted": false,
      "text": "Ping sends ICMP Echo Requests (Type 8)\nexpecting Echo Replies (Type 0) to\nverify bidirectional end-to-end\nreachability and measure Round-Trip Time\n(RTT).",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "flow-mu423oaj-17-note-1",
      "type": "text",
      "x": 784,
      "y": -144,
      "width": 314,
      "height": 95,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu423oan_1"
      ],
      "roundness": null,
      "seed": 402598,
      "version": 1,
      "versionNonce": 46333,
      "isDeleted": false,
      "text": "Traceroute transmits packets with\nincrementing TTL values (1, 2, 3...) to\ntrigger ICMP Time Exceeded (Type 11)\nmessages, mapping each transit router in\nthe forwarding path.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "sub-mu423oaj-2",
      "type": "rectangle",
      "x": -105,
      "y": -210,
      "width": 210,
      "height": 51,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
