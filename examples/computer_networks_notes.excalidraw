    {
      "id": "sub-mu42ze1z-15-note",
      "type": "text",
      "x": 405,
      "y": 71,
      "width": 314,
      "height": 76,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ze23_1"
      ],
      "roundness": null,
      "seed": 828762,
      "version": 1,
      "versionNonce": 155728,
      "isDeleted": false,
      "text": "Internet Control Message Protocol (ICMP)\noperates alongside IPv4 to communicate\nnetwork layer errors and diagnostic\nmetrics back to source hosts.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-sub-mu42ze1z-15-sub-mu42ze1z-15-note",
          "type": "arrow"
        }
      ]
    },
