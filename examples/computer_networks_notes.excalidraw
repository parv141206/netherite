      ],
      "roundness": {
        "type": 3
      },
      "seed": 681629,
      "version": 1,
      "versionNonce": 223351,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "sub-mu42ze1z-28_text",
          "type": "text"
        },
        {
          "id": "edge-topic-mu42ze1z-20-sub-mu42ze1z-28",
