    {
      "id": "sub-mu42ze1z-45_text",
      "type": "text",
      "x": -673,
      "y": 2500,
      "width": 377,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ze23_3"
      ],
      "roundness": null,
      "seed": 51179,
      "version": 1,
      "versionNonce": 827987,
      "isDeleted": false,
      "text": "Core Protocols & Production Use Cases",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42ze1z-45"
    },
    {
      "id": "sub-mu42ze1z-43-note",
      "type": "text",
      "x": -1039,
      "y": 2299,
      "width": 314,
      "height": 171,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ze23_3"
      ],
      "roundness": null,
      "seed": 863089,
      "version": 1,
      "versionNonce": 346319,
      "isDeleted": false,
      "text": "UDP computes an optional 16-bit one's\ncomplement checksum over a pseudo-header\n(Source IP, Destination IP, Protocol 17,\nUDP Length) combined with the header and\npayload. Corrupted datagrams are\ndiscarded silently without generating\nACKs or error packets, delegating any\nrecovery logic to user-space application\nprotocols.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-sub-mu42ze1z-43-sub-mu42ze1z-43-note",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "sub-mu42ze1z-45-note",
      "type": "text",
      "x": -1086,
      "y": 2515,
      "width": 306,
      "height": 152,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ze23_3"
      ],
      "roundness": null,
      "seed": 72362,
      "version": 1,
      "versionNonce": 160771,
      "isDeleted": false,
      "text": "UDP powers real-time and foundational\nnetwork infrastructure: DNS queries for\ninstant domain resolution, DHCP for\nbootstrap host configuration, NTP for\ndistributed clock synchronization, and\nWebRTC / RTP for real-time video\nconferencing where low latency\nsupersedes packet retransmission.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-sub-mu42ze1z-45-sub-mu42ze1z-45-note",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "sub-mu42ze1z-40",
