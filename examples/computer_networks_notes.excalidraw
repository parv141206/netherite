      "version": 1,
      "versionNonce": 965314,
      "isDeleted": false,
      "text": "Protocol Trade-offs",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42ze20-47"
    },
    {
      "id": "sub-mu42ze20-47-note",
      "type": "text",
      "x": 405,
      "y": 2526,
      "width": 306,
      "height": 57,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ze23_3"
      ],
      "roundness": null,
      "seed": 97524,
      "version": 1,
      "versionNonce": 794144,
      "isDeleted": false,
      "text": "Understanding when to select TCP versus\nUDP is fundamental to high-performance\nnetwork system design.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-sub-mu42ze20-47-sub-mu42ze20-47-note",
          "type": "arrow"
        }
      ]
    },
    {
