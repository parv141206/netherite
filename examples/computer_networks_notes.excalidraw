          "id": "sub-mu423oak-47_text",
          "type": "text"
        }
      ]
    },
    {
      "id": "sub-mu423oak-47_text",
      "type": "text",
      "x": 392,
      "y": 2450,
      "width": 205,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu423oan_3"
      ],
      "roundness": null,
      "seed": 578028,
      "version": 1,
      "versionNonce": 424236,
      "isDeleted": false,
      "text": "Protocol Trade-offs",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu423oak-47"
    },
    {
      "id": "sub-mu423oak-47-note",
      "type": "text",
      "x": 405,
      "y": 2526,
      "width": 306,
      "height": 57,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu423oan_3"
      ],
      "roundness": null,
      "seed": 791024,
      "version": 1,
      "versionNonce": 295175,
      "isDeleted": false,
      "text": "Understanding when to select TCP versus\nUDP is fundamental to high-performance\nnetwork system design.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "flow-mu423oak-49",
      "type": "rectangle",
      "x": 400,
      "y": 2301,
      "width": 242,
      "height": 49,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu423oan_3"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 720815,
      "version": 1,
      "versionNonce": 268372,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "flow-mu423oak-49_text",
          "type": "text"
        }
      ]
    },
    {
      "id": "flow-mu423oak-49_text",
      "type": "text",
      "x": 410,
      "y": 2316,
      "width": 222,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu423oan_3"
      ],
      "roundness": null,
      "seed": 223033,
      "version": 1,
      "versionNonce": 561021,
      "isDeleted": false,
      "text": "Architectural Comparison",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "flow-mu423oak-49"
    },
    {
      "id": "flow-mu423oak-49-note-0",
      "type": "text",
      "x": 702,
      "y": 2200,
      "width": 298,
      "height": 76,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu423oan_3"
      ],
      "roundness": null,
      "seed": 212777,
      "version": 1,
      "versionNonce": 214481,
      "isDeleted": false,
      "text": "TCP guarantees reliable, in-order byte\ndelivery with congestion throttling at\nthe cost of 3-way handshake delay and\nhead-of-line blocking stalls.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "flow-mu423oak-49-note-1",
      "type": "text",
      "x": 702,
      "y": 2311,
      "width": 306,
      "height": 76,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu423oan_3"
      ],
      "roundness": null,
      "seed": 734916,
      "version": 1,
      "versionNonce": 518407,
      "isDeleted": false,
      "text": "UDP delivers unthrottled zero-latency\ndatagrams with minimal packet overhead,\nserving as the modern foundation for\nHTTP/3 QUIC transport.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "sub-mu423oak-38",
      "type": "rectangle",
      "x": -162,
      "y": 2245,
      "width": 325,
      "height": 51,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu423oan_3"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 823628,
      "version": 1,
      "versionNonce": 445321,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "sub-mu423oak-38_text",
          "type": "text"
        }
      ]
    },
    {
      "id": "sub-mu423oak-38_text",
      "type": "text",
      "x": -150,
      "y": 2260,
      "width": 301,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu423oan_3"
      ],
      "roundness": null,
      "seed": 518547,
      "version": 1,
      "versionNonce": 603049,
      "isDeleted": false,
      "text": "Stateless & Minimal Transport",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu423oak-38"
    },
    {
      "id": "sub-mu423oak-38-note",
      "type": "text",
      "x": -172,
      "y": 2024,
      "width": 314,
      "height": 171,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu423oan_3"
      ],
      "roundness": null,
      "seed": 633845,
      "version": 1,
      "versionNonce": 115259,
      "isDeleted": false,
      "text": "UDP provides lightweight, connectionless\ndatagram transport with zero state\nmanagement. Unlike TCP, UDP executes no\nhandshakes, maintains no socket buffer\nstates, provides no retransmissions, and\nenforces no ordering or congestion\nbackoff. Applications gain direct, raw\ntransmission access to IP layer\nperformance.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "sub-mu423oak-43",
      "type": "rectangle",
      "x": -675,
      "y": 2314,
      "width": 391,
      "height": 51,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu423oan_3"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 541341,
      "version": 1,
      "versionNonce": 474895,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "sub-mu423oak-43_text",
          "type": "text"
        }
      ]
    },
    {
      "id": "sub-mu423oak-43_text",
      "type": "text",
      "x": -663,
      "y": 2329,
      "width": 367,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu423oan_3"
      ],
      "roundness": null,
      "seed": 902750,
      "version": 1,
      "versionNonce": 756194,
      "isDeleted": false,
      "text": "Error Detection & Checksum Mechanism",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu423oak-43"
    },
    {
      "id": "sub-mu423oak-45",
      "type": "rectangle",
      "x": -685,
      "y": 2485,
      "width": 401,
      "height": 51,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu423oan_3"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 293356,
      "version": 1,
      "versionNonce": 720940,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "sub-mu423oak-45_text",
          "type": "text"
        }
      ]
    },
    {
      "id": "sub-mu423oak-45_text",
      "type": "text",
      "x": -673,
      "y": 2500,
      "width": 377,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu423oan_3"
      ],
      "roundness": null,
      "seed": 930077,
      "version": 1,
      "versionNonce": 51382,
      "isDeleted": false,
      "text": "Core Protocols & Production Use Cases",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu423oak-45"
    },
    {
      "id": "sub-mu423oak-43-note",
      "type": "text",
      "x": -1039,
      "y": 2299,
      "width": 314,
      "height": 171,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu423oan_3"
      ],
      "roundness": null,
      "seed": 880160,
      "version": 1,
      "versionNonce": 490601,
      "isDeleted": false,
      "text": "UDP computes an optional 16-bit one's\ncomplement checksum over a pseudo-header\n(Source IP, Destination IP, Protocol 17,\nUDP Length) combined with the header and\npayload. Corrupted datagrams are\ndiscarded silently without generating\nACKs or error packets, delegating any\nrecovery logic to user-space application\nprotocols.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "sub-mu423oak-45-note",
      "type": "text",
      "x": -1086,
      "y": 2515,
      "width": 306,
      "height": 152,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu423oan_3"
      ],
      "roundness": null,
      "seed": 628810,
      "version": 1,
      "versionNonce": 150225,
      "isDeleted": false,
      "text": "UDP powers real-time and foundational\nnetwork infrastructure: DNS queries for\ninstant domain resolution, DHCP for\nbootstrap host configuration, NTP for\ndistributed clock synchronization, and\nWebRTC / RTP for real-time video\nconferencing where low latency\nsupersedes packet retransmission.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "edge-topic-mu423oaj-1-sub-mu423oaj-6",
