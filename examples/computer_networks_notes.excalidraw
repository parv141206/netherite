      "seed": 606295,
      "version": 1,
      "versionNonce": 641402,
      "isDeleted": false,
      "text": "Diagnostics & Control Protocols",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu423oaj-15"
    },
    {
      "id": "sub-mu423oaj-15-note",
      "type": "text",
      "x": 405,
      "y": 71,
      "width": 314,
      "height": 76,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu423oan_1"
      ],
      "roundness": null,
      "seed": 84110,
      "version": 1,
      "versionNonce": 629682,
      "isDeleted": false,
      "text": "Internet Control Message Protocol (ICMP)\noperates alongside IPv4 to communicate\nnetwork layer errors and diagnostic\nmetrics back to source hosts.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "flow-mu423oaj-17",
      "type": "rectangle",
      "x": 400,
      "y": -154,
      "width": 259,
      "height": 49,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu423oan_1"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 262192,
      "version": 1,
      "versionNonce": 311888,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "flow-mu423oaj-17_text",
          "type": "text"
        }
      ]
    },
    {
      "id": "flow-mu423oaj-17_text",
      "type": "text",
      "x": 410,
      "y": -139,
      "width": 239,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
