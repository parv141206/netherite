      "version": 1,
      "versionNonce": 647415,
      "isDeleted": false,
      "text": "User Datagram Protocol (UDP)",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "topic-mu423oak-37"
    },
    {
      "id": "sub-mu423oak-40",
      "type": "rectangle",
      "x": -176,
      "y": 2645,
      "width": 353,
      "height": 51,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "grp_mu423oan_3"
      ],
      "roundness": {
        "type": 3
      },
