      "opacity": 100,
      "groupIds": [
        "grp_mu42ze23_3"
      ],
      "roundness": {
        "type": 3
      },
      "seed": 876967,
      "version": 1,
      "versionNonce": 956821,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "flow-mu42ze20-49_text",
          "type": "text"
        },
        {
          "id": "edge-sub-mu42ze20-47-flow-mu42ze20-49",
