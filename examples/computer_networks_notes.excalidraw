    {
      "id": "diagram-mu42ze1z-27_code",
      "type": "text",
      "x": 572,
      "y": 1510,
      "width": 515,
      "height": 296,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
