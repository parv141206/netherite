    {
      "id": "sub-mu42ze1z-40_text",
      "type": "text",
      "x": -164,
      "y": 2660,
      "width": 329,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ze23_3"
      ],
      "roundness": null,
      "seed": 615971,
      "version": 1,
      "versionNonce": 665953,
      "isDeleted": false,
      "text": "Fixed 8-Byte Header Architecture",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sub-mu42ze1z-40"
    },
    {
      "id": "sub-mu42ze1z-40-note",
      "type": "text",
      "x": -172,
      "y": 2746,
      "width": 314,
      "height": 152,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ze23_3"
      ],
      "roundness": null,
      "seed": 834549,
      "version": 1,
      "versionNonce": 573979,
      "isDeleted": false,
      "text": "UDP features an ultra-compact 8-byte\nheader minimizing packet overhead and\nserialization latency. It consists of\nfour 16-bit fields: Source Port,\nDestination Port, Length (header +\npayload, min 8 bytes), and Checksum. The\nsimple structure allows line-rate ASIC\nparsing in network hardware.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-sub-mu42ze1z-40-sub-mu42ze1z-40-note",
          "type": "arrow"
        }
      ]
    },
