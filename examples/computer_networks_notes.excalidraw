    },
    {
      "id": "flow-mu42ze1z-17-note-0",
      "type": "text",
      "x": 784,
      "y": -269,
      "width": 314,
      "height": 95,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ze23_1"
      ],
      "roundness": null,
      "seed": 645534,
      "version": 1,
      "versionNonce": 832012,
      "isDeleted": false,
      "text": "Ping sends ICMP Echo Requests (Type 8)\nexpecting Echo Replies (Type 0) to\nverify bidirectional end-to-end\nreachability and measure Round-Trip Time\n(RTT).",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-flow-mu42ze1z-17-flow-mu42ze1z-17-note-0",
          "type": "arrow"
        }
      ]
    },
    {
      "id": "flow-mu42ze1z-17-note-1",
      "type": "text",
      "x": 784,
      "y": -85,
      "width": 314,
      "height": 95,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_mu42ze23_1"
      ],
      "roundness": null,
      "seed": 273477,
      "version": 1,
      "versionNonce": 137681,
      "isDeleted": false,
      "text": "Traceroute transmits packets with\nincrementing TTL values (1, 2, 3...) to\ntrigger ICMP Time Exceeded (Type 11)\nmessages, mapping each transit router in\nthe forwarding path.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "boundElements": [
        {
          "id": "edge-flow-mu42ze1z-17-flow-mu42ze1z-17-note-1",
          "type": "arrow"
        }
      ]
    },
