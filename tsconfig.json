{
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    /* Strictness */
    "strict": true,
    "checkJs": true,

    /* Bundled projects */
    "lib": ["dom", "dom.iterable", "ES2023"],
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "incremental": true,

    /* Path Aliases */
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["./src/*"],
      "@excalidraw/common": ["./src/excalidraw/common/src/index.ts"],
      "@excalidraw/common/*": ["./src/excalidraw/common/src/*"],
      "@excalidraw/element": ["./src/excalidraw/element/src/index.ts"],
      "@excalidraw/element/*": ["./src/excalidraw/element/src/*"],
      "@excalidraw/excalidraw": ["./src/excalidraw/excalidraw/index.tsx"],
      "@excalidraw/excalidraw/*": ["./src/excalidraw/excalidraw/*"],
      "@excalidraw/fractional-indexing": [
        "./src/excalidraw/fractional-indexing/src/index.ts"
      ],
      "@excalidraw/laser-pointer": [
        "./src/excalidraw/laser-pointer/src/index.ts"
      ],
      "@excalidraw/math": ["./src/excalidraw/math/src/index.ts"],
      "@excalidraw/math/*": ["./src/excalidraw/math/src/*"],
      "@excalidraw/utils": ["./src/excalidraw/utils/src/index.ts"],
      "@excalidraw/utils/*": ["./src/excalidraw/utils/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.cjs",
    "**/*.js",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "generated"]
}
